+        // path's in 2 m chords of 4.5 m (25 degrees): the outer rut's line has no texel left
+        // in snow where two chords meet, and the inner rut grows no wedge toward the middle
+        for (radius, chord) in [(12.0, 3.0), (4.5, 2.0)] {
