diff --git a/crates/omsi-app/src/free_vehicles.rs b/crates/omsi-app/src/free_vehicles.rs
new file mode 100644
index 0000000..d90a39f
--- /dev/null
+++ b/crates/omsi-app/src/free_vehicles.rs
@@ -0,0 +1,40 @@
+//! Admission and local substitutes for managed BBS servers (protocol 6 unchanged).
+
+pub(crate) fn first_loaded<'a, T>(files: impl IntoIterator<Item = &'a str>, mut load: impl FnMut(&str) -> Option<T>) -> Option<T> {
+    files.into_iter().find_map(|f| load(f))
+}
+
+pub(crate) fn select_type<T>(admitted: bool, requested: &str, mut load: impl FnMut(&str) -> Option<T>, fallback: impl FnOnce() -> Option<T>) -> Option<(T, bool)> {
+    if admitted {
+        if let Some(t) = load(requested) { return Some((t, false)); }
+    }
+    fallback().map(|t| (t, true))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn private_bus_absent_on_host_gets_substitute_without_changing_its_name() {
+        let bus = "Vehicles/Private/Torino.bus";
+        let mut attempted = String::new();
+        let result = select_type(true, bus, |f| { attempted = f.into(); None }, || Some("MAN"));
+        assert_eq!(result, Some(("MAN", true)));
+        assert_eq!(attempted, bus);
+    }
+    #[test]
+    fn installed_unlisted_bus_keeps_its_real_model() {
+        let result = select_type(true, "Vehicles/Private/Torino.bus", |_| Some("Torino"), || panic!("unexpected substitute"));
+        assert_eq!(result, Some(("Torino", false)));
+    }
+    #[test]
+    fn failed_optional_substitutes_do_not_hide_a_working_original_bus() {
+        let result = first_loaded(["Vehicles/Old/Missing.bus", "Vehicles/Broken/Bad.bus", "Vehicles/MAN/Default.bus"], |f| f.ends_with("Default.bus").then_some("MAN"));
+        assert_eq!(result, Some("MAN"));
+    }
+    #[test]
+    fn legacy_policy_and_no_local_models_do_not_invent_a_real_vehicle() {
+        assert_eq!(select_type(false, "private.bus", |_| panic!("legacy denial must not load"), || Some("MAN")), Some(("MAN", true)));
+        assert_eq!(select_type::<()>(true, "private.bus", |_| None, || None), None);
+    }
+}
