+    """                if same_way && matches_trip {
+                    reg.next = Some(*id);
+                }""",
+    """                if same_way && matches_trip {
+                    let now_scheduled = bn.next_stop.as_ref().is_some_and(|next| next.id == *id);
+                    let old_scheduled = reg.next.is_some_and(|prev|
+                        bn.next_stop.as_ref().is_some_and(|next| next.id == prev));
