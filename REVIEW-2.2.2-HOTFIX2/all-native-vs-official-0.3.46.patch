-            let now_p = DVec3::new(c.pos[0], c.pos[1], c.pos[2]);
-            let moved = (now_p - before).truncate().length() as f32;
-            let odo = m.odometer.entry(*id).or_insert(0.0);
-            if moved < 30.0 {
-                *odo += moved * (c.speed as f32).signum();
-            }
