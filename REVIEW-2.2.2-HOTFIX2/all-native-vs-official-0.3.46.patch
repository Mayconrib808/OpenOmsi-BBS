++                                .coop
++                                .receipts
++                                .entry(key)
++                                .or_default()
++                                .record(a.seq, ok);
++                        }
++                        ok
++                    }
++                };
++                self.coop_send(
++                    from,
++                    Message::Ack {
++                        epoch: a.epoch,
++                        seq: a.seq,
++                        ok,
++                    },
++                );
++            }
++        }
++        true
++    }
