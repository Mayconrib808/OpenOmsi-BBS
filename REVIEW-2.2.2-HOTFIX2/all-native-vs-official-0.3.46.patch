++ tube(&mut m,Vec3::new(0.,0.,-0.055),Vec3::new(0.,0.,-0.13),0.013,1);
++ let f=|i:usize|{let a=i as f32*std::f32::consts::PI/12.;Vec3::new(0.045-0.045*a.cos(),0.,-0.13-0.045*a.sin())};
