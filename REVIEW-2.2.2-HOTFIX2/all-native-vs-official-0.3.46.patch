diff --git a/crates/omsi-app/src/bcs_events/assets.rs b/crates/omsi-app/src/bcs_events/assets.rs
new file mode 100644
index 0000000000000000000000000000000000000000..741b8344a80e4097f7e875c75b2d115a07fd059c
--- /dev/null
+++ b/crates/omsi-app/src/bcs_events/assets.rs
@@ -0,0 +1,255 @@
+//! Only explicit/curated vehicle definitions assign a service role. No filename heuristics.
+use omsi_sim::{
+    VehicleType,
+    ai_traffic::response::{Service, Signals},
+};
+use serde::Deserialize;
+use std::{
+    collections::BTreeMap,
+    path::{Component, Path, PathBuf},
+    sync::{Arc, Mutex},
+};
+
+const BMW: &str = "Vehicles/MIPA/MIPA_AI_BMW_F31/MIPA_AI_BMW_F31_pol_active.ovh";
+const ROMAN: &str = "Vehicles/RO_Roman_Diesel/Roman_apca.bus";
+const AMBULANCE: &str = "Vehicles/MB_T1/ai_mb_t1_rtw.ovh";
+
+#[derive(Clone)]
+pub(super) struct Model {
+    pub ty: Arc<VehicleType>,
+    pub signals: Arc<Signals>,
+}
+#[derive(Default)]
+pub(super) struct Catalog {
+    pub medical: Option<Model>,
+    pub police: Option<Model>,
+    pub fire: Option<Model>,
+}
+impl Catalog {
+    pub fn model(&self, service: Service) -> Option<Model> {
+        match service {
+            Service::Medical => &self.medical,
+            Service::Police => &self.police,
+            Service::Fire => &self.fire,
+        }
+        .clone()
+    }
+}
+
+#[derive(Default, Deserialize)]
+struct Binding {
+    model: String,
+    #[serde(default)]
+    en_route: BTreeMap<String, f32>,
+    #[serde(default)]
+    on_scene: BTreeMap<String, f32>,
+    #[serde(default)]
+    departing: BTreeMap<String, f32>,
+}
+#[derive(Default, Deserialize)]
+struct Config {
+    #[serde(default)]
+    ambulance: Option<Binding>,
+    #[serde(default)]
+    police: Option<Binding>,
+    #[serde(default)]
+    fire: Option<Binding>,
+}
+
+#[derive(Default)]
+pub(super) struct Loader {
+    value: Option<Arc<Mutex<Option<Catalog>>>>,
+}
+impl Loader {
+    pub fn start(&mut self, root: PathBuf) {
+        if self.value.is_some() {
+            return;
+        }
+        if let Some(root)=std::env::current_exe().ok().and_then(|p|p.parent().map(|p|p.join("bcs-assets"))).filter(|p|p.is_dir()) {
+            // A shared relative Vehicles/OpenOMSI_BCS path resolves on every
+            // client/server; installed content retains its existing priority.
+            omsi_cfg::add_content_root(root);
+        }
+        let value = Arc::new(Mutex::new(None));
+        self.value = Some(value.clone());
+        let launched = std::thread::Builder::new()
+            .name("BCS emergency model loader".into())
+            .spawn(move || {
+                let path = root.join("bcs-emergency-vehicles.json");
+                let config = if path.exists() {
+                    match std::fs::metadata(&path)
+                        .ok()
+                        .filter(|m| m.len() <= 65536)
+                        .and_then(|_| std::fs::read(&path).ok())
+                        .and_then(|b| serde_json::from_slice::<Config>(&b).ok())
+                    {
+                        Some(c) => c,
+                        None => {
+                            log::warn!(
+                                "BCS emergency model configuration is invalid; no models loaded"
+                            );
+                            return;
+                        }
+                    }
+                } else {
+                    Config::default()
+                };
+                let fallback = std::env::current_exe().ok().and_then(|p|p.parent().map(|p|p.join("bcs-assets")));
+                let police_custom=config.police.is_some();let fire_custom=config.fire.is_some();
+                let catalog = Catalog {
+                    medical: load(&root, config.ambulance, AMBULANCE, Service::Medical),
+                    police: load(&root, config.police, BMW, Service::Police).or_else(||
+                        if police_custom {None} else {fallback.as_ref().and_then(|p|load(p,None,"Vehicles/OpenOMSI_BCS/Police/Police.ovh",Service::Police))}),
+                    fire: load(&root, config.fire, ROMAN, Service::Fire).or_else(||
+                        if fire_custom {None} else {fallback.as_ref().and_then(|p|load(p,None,"Vehicles/OpenOMSI_BCS/Fire/Fire.ovh",Service::Fire))}),
+                };
+                if let Ok(mut slot) = value.lock() {
+                    *slot = Some(catalog);
+                }
+            });
+        if launched.is_err() {
+            self.value = None;
+        }
+    }
+    pub fn model(&self, service: Service) -> Option<Model> {
+        self.value.as_ref()?.lock().ok()?.as_ref()?.model(service)
+    }
+}
+
+fn relative(text: &str) -> Option<PathBuf> {
+    let text = text.replace('\\', "/");
+    let path = PathBuf::from(&text);
+    if text.contains(':')
+        || path.is_absolute()
+        || path
+            .components()
+            .any(|c| !matches!(c, Component::Normal(_)))
+    {
+        return None;
+    }
+    match path.extension()?.to_str()?.to_ascii_lowercase().as_str() {
+        "bus" | "ovh" => Some(path),
+        _ => None,
+    }
+}
+
+fn load(root: &Path, binding: Option<Binding>, default: &str, service: Service) -> Option<Model> {
+    let binding = binding.unwrap_or_else(|| Binding {
+        model: default.into(),
+        ..Default::default()
+    });
+    let signals = signals(&binding, service)?;
+    let relative = relative(&binding.model)?;
+    let path = omsi_cfg::resolve_path(root, relative.to_str()?);
+    if !path.is_file() {
+        log::info!(
+            "BCS {:?} visual model not installed: {}",
+            service,
+            relative.display()
+        );
+        return None;
+    }
+    let canonical = root.canonicalize().ok()?;
+    if !path.canonicalize().ok()?.starts_with(&canonical) {
+        return None;
+    }
+    let ty = match VehicleType::load_ai(root, &path) {
+        Ok(t) => Arc::new(t),
+        Err(e) => {
+            log::warn!("BCS {:?} model could not load: {e}", service);
+            return None;
+        }
+    };
+    Some(Model {
+        ty,
+        signals: Arc::new(signals),
+    })
+}
+
+fn signals(binding: &Binding, service: Service) -> Option<Signals> {
+    let valid = |vars: &BTreeMap<String, f32>| {
+        vars.len() <= 32
+            && vars
+                .iter()
+                .all(|(n, v)| !n.is_empty() && n.len() <= 80 && v.is_finite() && v.abs() <= 1e6)
+    };
+    if !valid(&binding.en_route) || !valid(&binding.on_scene) || !valid(&binding.departing) {
+        return None;
+    }
+    let model = binding.model.replace('\\', "/");
+    let mut signals = {
+        let variables = |names: &[&str], v: f32| names.iter().map(|n| (n.to_string(), v)).collect();
+        match (service, model.as_str()) {
+            (Service::Police, path) if path.eq_ignore_ascii_case(BMW) => Signals {
+                en_route: variables(&["rtk_stadthorn"], 1.0),
+                on_scene: variables(&["rtk_stadthorn"], 0.0),
+                departing: variables(
+                    &["rtk_stadthorn", "bl_frontblitzer", "bl_rtk1", "bl_rtk2"],
+                    0.0,
+                ),
+            },
+            (Service::Fire, path) if path.eq_ignore_ascii_case(ROMAN) => Signals {
+                en_route: variables(&["Folgetonhorn"], 1.0),
+                on_scene: variables(&["Folgetonhorn"], 0.0),
+                departing: variables(&["Folgetonhorn", "blaulicht_1", "blaulicht_2"], 0.0),
+            },
+            (_, path) if path.starts_with("Vehicles/OpenOMSI_BCS/") => Signals {
+                en_route: variables(&["bcs_siren","bcs_beacon"],1.0),
+                on_scene: vec![("bcs_siren".into(),0.0),("bcs_beacon".into(),1.0)],
+                departing: variables(&["bcs_siren","bcs_beacon","bcs_blue"],0.0),
+            },
+            _ => Signals::default(),
+        }
+    };
+    for (target, overrides) in [
+        (&mut signals.en_route, &binding.en_route),
+        (&mut signals.on_scene, &binding.on_scene),
+        (&mut signals.departing, &binding.departing),
+    ] {
+        let mut merged: BTreeMap<_, _> = std::mem::take(target).into_iter().collect();
+        merged.extend(overrides.iter().map(|(name, value)| (name.clone(), *value)));
+        *target = merged.into_iter().collect();
+    }
+    Some(signals)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn model_must_be_a_relative_vehicle_definition() {
+        assert!(relative(BMW).is_some());
+        assert!(relative(ROMAN).is_some());
+        for s in [
+            "C:\\outside.ovh",
+            "../outside.bus",
+            "/tmp/other.ovh",
+            "Vehicles/car.exe",
+            "",
+        ] {
+            assert!(relative(s).is_none(), "{s}");
+        }
+    }
+    #[test]
+    fn explicit_default_keeps_curated_signals_and_allows_overrides() {
+        let mut binding = Binding {
+            model: BMW.replace('/', "\\"),
+            ..Default::default()
+        };
+        binding.on_scene.insert("rtk_stadthorn".into(), 0.5);
+        let signals = signals(&binding, Service::Police).unwrap();
+        assert!(signals.en_route.contains(&("rtk_stadthorn".into(), 1.0)));
+        assert!(signals.on_scene.contains(&("rtk_stadthorn".into(), 0.5)));
+        assert!(signals.departing.contains(&("bl_frontblitzer".into(), 0.0)));
+    }
+    #[test]
+    fn an_unrelated_model_does_not_receive_bmw_script_variables() {
+        let binding = Binding {
+            model: "Vehicles/MyPolice/custom.ovh".into(),
+            ..Default::default()
+        };
+        let signals = signals(&binding, Service::Police).unwrap();
+        assert!(signals.en_route.is_empty());
+        assert!(signals.departing.is_empty());
+    }
+}
diff --git a/crates/omsi-app/src/bcs_events/dispatch.rs b/crates/omsi-app/src/bcs_events/dispatch.rs
new file mode 100644
index 0000000000000000000000000000000000000000..6bb88f7ad60b47a8476a076dd9874c957ba5deba
--- /dev/null
+++ b/crates/omsi-app/src/bcs_events/dispatch.rs
@@ -0,0 +1,198 @@
+//! A local medical response may finish visually after the BCS popup closes.
+//! Source completion is latched; arrival is read only from the actual AI vehicle.
+use super::{
+    assets::Loader,
+    lifecycle::{Key, Snapshot, Stage},
+};
+use glam::DVec3;
+use omsi_sim::ai_traffic::response::Service;
+
+struct Medical {
+    key: Key,
+    context: String,
+    patient: Option<u32>,
+    event: u32,
+    service: Service,
+    vehicle: Option<u64>,
+    bus_at: Option<DVec3>,
+    age: f32,
+    retry: f32,
+    completed: bool,
+    arrived: bool,
+    blend: f32,
+    stalled_reported: bool,
+}
+#[derive(Default)]
+pub(super) struct Dispatcher {
+    medical: Option<Medical>,
+    seen: Option<Key>,
+    retiring: Vec<u64>,
+    last_problem: Option<String>,
+}
+pub(super) struct Input<'a> {
+    pub context: Option<&'a str>,
+    pub source: Option<&'a Snapshot>,
+    pub key: Option<Key>,
+    pub stage: Stage,
+    pub patient: Option<u32>,
+    pub riders: &'a [u32],
+    pub blend: f32,
+    pub bus: DVec3,
+    pub heading: f64,
+    pub speed: f32,
+    pub dt: f32,
+}
+
+impl Dispatcher {
+    pub fn advance(
+        &mut self,
+        input: Input<'_>,
+        models: &Loader,
+        traffic: &mut crate::traffic::Traffic,
+        world: &crate::scene::World,
+    ) -> Option<u32> {
+        self.retiring
+            .retain(|&id| !traffic.retire_incident_vehicle(world, id));
+        let intent = input.source.filter(|s| !s.completed).and_then(|s| {
+            let service = service_for(s.event)?;
+            let requested = match service {Service::Medical=>3,Service::Police=>2,Service::Fire=>5};
+            if s.service != requested {return None;}
+            // Police and fire scenes belong to the event, not to whichever rider
+            // happens to occupy the first seat: that rider can move or alight.
+            let patient = if service == Service::Medical {Some(input.patient?)} else {None};
+            Some((Key{pid:s.pid,instance:s.instance},s.event,service,patient))
+        });
+        if self.medical.is_none() {
+            if let (Some((key,event,service,patient)),Some(context))=(intent,input.context) {
+                if self.seen != Some(key) && input.dt > 0.0 {
+                    self.seen = Some(key);
+                    log::info!("BCS response: accepted {:?} incident event={} instance={} patient={:?}",service,event,key.instance,patient);
+                    self.medical = Some(Medical { key,context:context.into(),patient,event,service,
+                        vehicle:None,bus_at:None,age:0.0,retry:0.0,completed:false,arrived:false,
+                        blend:input.blend,stalled_reported:false });
+                }
+            }
+        }
+        let scene = self.medical.as_mut()?;
+        let source_ok = input.source.is_some_and(|s| s.pid == scene.key.pid);
+        let moved = scene
+            .bus_at
+            .is_some_and(|at| (at - input.bus).length() > 8.0);
+        if input.context != Some(scene.context.as_str())
+            || !source_ok
+            || scene.patient.is_some_and(|p| !input.riders.contains(&p))
+            || moved
+            || scene.age > 180.0
+        {
+            log::warn!("BCS response: {:?} event={} cancelled context_ok={} source_ok={} rider_ok={} moved={} age={:.1}s",scene.service,scene.event,input.context==Some(scene.context.as_str()),source_ok,scene.patient.is_none_or(|p|input.riders.contains(&p)),moved,scene.age);
+            self.cancel(traffic);
+            return None;
+        }
+        if let Some(s) = input.source {
+            if s.pid == scene.key.pid
+                && s.instance == scene.key.instance
+                && s.event == scene.event
+                && s.completed
+            {
+                scene.completed = true;
+            }
+        }
+        let dt = input.dt.max(0.0).min(0.25);
+        scene.age += dt;
+        scene.retry -= dt;
+        scene.blend = (scene.blend + dt).min(1.0);
+        if scene.vehicle.is_none() && scene.retry <= 0.0 && input.speed.abs() < 1.0 && dt > 0.0 {
+            scene.retry = 0.5;
+            let result = match models.model(scene.service) {
+                Some(model) => traffic
+                    .dispatch_incident_vehicle(
+                        world,
+                        model.ty,
+                        input.bus,
+                        input.heading,
+                        scene.service,
+                    )
+                    .map(|id| {
+                        traffic.sim.set_response_signals(id, model.signals);
+                        id
+                    }),
+                None => Err(format!("{:?} responder model not loaded or installed",scene.service)),
+            };
+            match result {
+                Ok(id) => {
+                    scene.vehicle = Some(id);
+                    scene.bus_at = Some(input.bus);
+                    self.last_problem = None;
+                    log::info!(
+                        "BCS response: {:?} vehicle {id} dispatched for passenger {:?}",
+                        scene.service, scene.patient
+                    );
+                }
+                Err(problem) => {
+                    if self.last_problem.as_ref() != Some(&problem) {
+                        log::warn!("BCS response pending: {problem}");
+                        self.last_problem = Some(problem);
+                    }
+                }
+            }
+        }
+        if let Some(id) = scene.vehicle {
+            if !traffic.sim.cars.iter().any(|c| c.id == id) {
+                self.cancel(traffic);
+                return None;
+            }
+            if traffic.sim.response_on_scene(id) {
+                if !scene.arrived {
+                    scene.arrived = true;
+                    log::info!("BCS response: {:?} vehicle {id} physically on scene", scene.service);
+                }
+                if dt > 0.0 && transfer_ready(scene.completed, input.speed) {
+                    let patient = scene.patient;
+                    self.cancel(traffic);
+                    return patient;
+                }
+            } else if !scene.stalled_reported {
+                if let Some(car) = traffic.sim.cars.iter().find(|c| c.id == id && c.stopped >= 2.0) {
+                    scene.stalled_reported = true;
+                    log::warn!("BCS response: {:?} vehicle {id} stopped before arrival: reason {}, bus distance {:.1} m, lane {}, s {:.1}, response {:?}", scene.service,car.why.0, (car.vehicle.position - input.bus).length(), car.state.lane, car.state.s, car.response);
+                }
+            }
+        }
+        None
+    }
+    pub fn pose(&self) -> Option<(u32, f32)> {
+        self.medical.as_ref().filter(|s|s.service==Service::Medical).and_then(|s|s.patient.map(|p|(p,s.blend)))
+    }
+    pub fn cancel(&mut self, traffic: &mut crate::traffic::Traffic) {
+        if let Some(id) = self.medical.take().and_then(|s| s.vehicle) {
+            let released = traffic.sim.release_response(id);
+            if released && self.retiring.len() < 16 {
+                self.retiring.push(id);
+            }
+            log::info!("BCS response: vehicle {id} released to drive away");
+        }
+    }
+    pub fn clear_without_world(&mut self) {
+        self.medical = None;
+        self.retiring.clear();
+    }
+}
+
+fn transfer_ready(bcs_complete: bool, bus_speed: f32) -> bool {
+    bcs_complete && bus_speed.is_finite() && bus_speed.abs() < 1.0
+}
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn bcs_delay_alone_does_not_transfer_a_passenger() {
+        assert!(!transfer_ready(false, 0.0));
+        assert!(!transfer_ready(true, 30.0));
+        assert!(transfer_ready(true, 0.0));
+    }
+}
+
+/// Visual services only. Radio contest and passenger count have no native vehicle.
+fn service_for(event:u32)->Option<Service>{
+    match event {1..=4=>Some(Service::Medical),6|7=>Some(Service::Police),30..=32=>Some(Service::Fire),_=>None}
+}
