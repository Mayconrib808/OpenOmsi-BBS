++            return true;
++        };
++        match message {
++            Message::Keep(0) => {
++                if let Some(h) = self.held.get_mut(&from) {
++                    h.seen = Instant::now();
++                }
++            }
++            Message::Action(a) => {
++                let cached = self.receipts.get(&from).and_then(|r| r.cached(a.seq));
++                if cached == Some(true) {
++                    if let Some(h) = self.held.get_mut(&from).filter(|h| h.action.seq == a.seq) {
