+            && p.door_since.is_some_and(|since| self.time - since >= 8.0)
+            && (!may_leave || p.st != 7) {
+            let reason = if reg.next.is_none() && p.complaint != 3 {
+                "stop_not_recognized"
+            } else if p.door.is_none() { "no_exit_selected" }
+              else if !door_open { "selected_exit_closed" }
+              else { "walking_or_path_blocked" };
