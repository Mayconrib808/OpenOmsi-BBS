++ name.chars().filter_map(|c|match c{
++  'á'|'à'|'â'|'ã'|'ä'=>Some('a'),'é'|'è'|'ê'|'ë'=>Some('e'),'í'|'ì'|'î'|'ï'=>Some('i'),
