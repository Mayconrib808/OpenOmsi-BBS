+impl LanWorld {
+    /// Once a frame, after `LanSession::tick`.
+    #[allow(clippy::too_many_arguments)]
+    pub fn tick(
+        &mut self,
+        lan: &mut LanSession,
+        dt: f32,
+        args: &LanConfig,
+        world: Option<&World>,
+        renderer: Option<&Renderer>,
+        scene: Option<&mut Scene>,
+        traffic: Option<&mut Traffic>,
+        humans: Option<&mut Humans>,
+        view: &mut SimView,
