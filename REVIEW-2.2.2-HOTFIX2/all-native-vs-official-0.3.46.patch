++                            seq: a.seq,
++                            ok: false,
++                        },
++                    );
++                    return true;
++                }
++                let cached = self
++                    .net
++                    .coop
++                    .receipts
++                    .get(&key)
++                    .and_then(|r| r.cached(a.seq));
++                let ok = match cached {
++                    Some(ok) => {
++                        if ok {
++                            if let Some(h) = self
++                                .net
++                                .coop
++                                .held
++                                .get_mut(&from)
++                                .filter(|h| h.action.epoch == a.epoch && h.action.seq == a.seq)
++                            {
++                                h.seen = Instant::now();
++                            }
++                        }
++                        ok
++                    }
++                    None => {
++                        let ok = self.coop_apply(from, &a);
++                        // Delivery to another authority is not execution. Only its
