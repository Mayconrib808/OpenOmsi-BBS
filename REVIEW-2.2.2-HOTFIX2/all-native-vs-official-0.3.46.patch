+                            };
+                            motion.apply(&mut p.vehicle);
+                            if let Some(o) = self.net.coop.drive.owner.as_mut() { o.motion = Some(motion); }
+                            let h = &mut p.vehicle.host;
+                            h.tt_line = tt.0;
+                            h.tt_delay = tt.1;
+                            h.tt_stops = tt.2;
+                            h.tt_stop_ids = tt.3;
+                            h.tt_terminus_index = tt.4;
+                            h.tt_busstop_index = tt.5;
+                            for (n, value) in preserve {
