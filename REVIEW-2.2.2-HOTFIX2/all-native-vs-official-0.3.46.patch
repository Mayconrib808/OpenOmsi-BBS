++ let mut m=MeshData::default();
++ for i in 0..5{let a=i as f32*TAU/5.;let p=Vec3::new(a.cos()*0.018,a.sin()*0.018,-(i as f32)*0.035);tube(&mut m,p,p+Vec3::Z*0.018,0.0035,0);}
