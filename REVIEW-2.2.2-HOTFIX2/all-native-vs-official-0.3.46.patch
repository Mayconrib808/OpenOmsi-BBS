++#[derive(Clone)]
++pub struct Bus {
++    pub id: BusId,
++    pub position: DVec3,
++    pub heading: f64,
++    pub speed: f32,
++    pub line: String,
++    pub horn: bool,
++    pub high_beam: bool,
++}
