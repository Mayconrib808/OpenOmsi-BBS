+                    token,
+                    uid,
+                    bus,
+                    args,
+                    world,
+                    loading: Some(rx),
+                    prepared: None,
+                    parked: None,
+                    original_bus: self.args.bus.clone(),
+                    foot: None,
+                    original_duty: None,
+                    active: false,
+                    returning: false,
+                    actors: HashSet::new(),
+                    desk: 0,
+                    cash: Default::default(),
+                    cash_view: Default::default(),
+                    images: Vec::new(),
+                    seen: now,
+                    sent: now,
+                    started: now,
