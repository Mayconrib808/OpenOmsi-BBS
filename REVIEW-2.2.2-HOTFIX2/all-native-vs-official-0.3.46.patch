++fn rut_shape(along: f64, seed: f64) -> [f64; 3] {
++    [
++        (along / 9.0 + seed).sin() * 0.07 + (along / 3.7 + seed * 2.3).sin() * 0.03,
++        RUT_SIGMA * (1.0 + 0.25 * (along / 6.3 + seed * 0.7).sin()),
++        0.75 + 0.25 * (along / 4.1 + seed * 1.9).sin(),
++    ]
++}
