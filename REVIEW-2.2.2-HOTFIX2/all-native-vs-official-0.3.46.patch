+name: Build 2.2.2 native integration
+concurrency:
+  group: openomsi-native-${{ github.ref }}
+  cancel-in-progress: true
+on:
+  push:
+    branches: [work/native-222-build, fix/2223-boarding-traffic-diagnostics-20261030]
+    paths: [ci/release222/apply_2223.py, ci/release222/native.patch, ci/release222/inspector-patrol.patch, ci/release222/door-reaction.patch, ci/release222/lan-traffic.patch, ci/release222/police-response.patch, ci/release222/emergency-model-axis.patch, crates/omsi-sim/src/people/buses.rs, crates/omsi-sim/src/people/tests.rs, crates/omsi-sim/src/people/pax_stops.rs, crates/omsi-app/src/traffic/population.rs, crates/omsi-app/src/app_impl/lan_tick.rs, crates/omsi-app/src/lan_world.rs, .github/workflows/native-222-build.yml]
+  workflow_dispatch: {}
+permissions:
+  contents: read
+jobs:
+  native:
+    runs-on: windows-2022
+    timeout-minutes: 100
+    env:
+      OPENOMSI_VERSION: 0.3.46-coop.15-2.2.2
+      OPENOMSI_BCS_EVENTS_BETA_DEFAULT: '1'
+      OPENOMSI_COOP_GAME_ONLY: '1'
+      TAURI_CONFIG: '{"version":"0.3.46"}'
+      CARGO_INCREMENTAL: '0'
+      CARGO_PROFILE_RELEASE_DEBUG: '0'
+      CARGO_PROFILE_RELEASE_LTO: 'false'
+      CARGO_PROFILE_RELEASE_CODEGEN_UNITS: '16'
+    steps:
+      - name: Use LF source files on the ephemeral Windows runner
+        shell: pwsh
+        run: git config --global core.autocrlf false
+      - uses: actions/checkout@v4
+        with:
+          persist-credentials: false
+      - name: Apply cumulative source delta and record exact source tree
+        shell: pwsh
+        run: |
+          git apply --index ci/release222/native.patch
+          if ($LASTEXITCODE -ne 0) { throw 'Cumulative source patch failed' }
+          git apply --index ci/release222/inspector-patrol.patch
+          if ($LASTEXITCODE -ne 0) { throw 'Inspector route-patrol patch failed' }
+          git apply --index ci/release222/door-reaction.patch
+          if ($LASTEXITCODE -ne 0) { throw 'Door reaction diagnostics patch failed' }
