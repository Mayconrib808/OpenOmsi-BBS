index 0000000000000000000000000000000000000000..b850dd7e91972dc1460dfecfbb0d2309a0d9ac8b
--- /dev/null
+++ b/UPSTREAM-REVIEW/upstream-workflows/codeql.yml
@@ -0,0 +1,47 @@
+name: CodeQL
+
+on:
+  push:
+    branches: [main]
+  pull_request:
+  schedule:
+    - cron: "0 5 * * *"
+  workflow_dispatch:
+
+concurrency:
+  group: codeql-${{ github.event_name }}-${{ github.ref }}
+  cancel-in-progress: ${{ github.event_name == 'pull_request' }}
+
+permissions:
+  contents: read
+
+jobs:
+  analyze:
+    name: Analyze (${{ matrix.language }})
+    runs-on: ubuntu-latest
+    permissions:
+      contents: read
+      actions: read
+      security-events: write
+    strategy:
+      fail-fast: false
+      matrix:
+        language: ${{ fromJSON((github.event_name == 'schedule' || github.event_name == 'workflow_dispatch') && '["rust", "javascript-typescript", "actions"]' || '["javascript-typescript", "actions"]') }}
+    steps:
+      - uses: actions/checkout@v7
+      - uses: github/codeql-action/init@v4
+        with:
+          languages: ${{ matrix.language }}
+          build-mode: none
+          # test files hold fixed passwords, salts and keys on purpose (a known answer, a
+          # password too short to take); a test module inside a source file cannot be told
+          # apart by its path and is still analysed
+          config: |
+            paths-ignore:
+              - launcher/patches
+              - "**/tests/**"
+              - "**/tests.rs"
+              - "**/*_tests.rs"
+      - uses: github/codeql-action/analyze@v4
+        with:
+          category: /language:${{ matrix.language }}
diff --git a/UPSTREAM-REVIEW/upstream-workflows/issue_language.yml b/UPSTREAM-REVIEW/upstream-workflows/issue_language.yml
new file mode 100644
index 0000000000000000000000000000000000000000..673308999e68e040070da39b493cf87050fc74db
--- /dev/null
+++ b/UPSTREAM-REVIEW/upstream-workflows/issue_language.yml
@@ -0,0 +1,50 @@
+# Issues are written in English (see CONTRIBUTING.md): an issue in another language is
+# closed with a comment asking for an English version, and opened again by itself once its
+# title and text are edited into English. Code blocks and logs do not count, so a crash log
+# with a non-English user folder is fine. Maintainers' issues are left alone.
+name: Issue language
+
+on:
+  issues:
+    types:
+      - opened
+      - edited
+      - reopened
+
+permissions:
+  issues: write
+
+jobs:
+  check:
+    if: ${{ !contains(fromJSON('["OWNER", "MEMBER", "COLLABORATOR"]'), github.event.issue.author_association) }}
+    runs-on: ubuntu-latest
+    env:
+      GH_TOKEN: ${{ github.token }}
+      GH_REPO: ${{ github.repository }}
+      NUMBER: ${{ github.event.issue.number }}
+      STATE: ${{ github.event.issue.state }}
+      LABEL: not in English
+      HAS_LABEL: ${{ contains(github.event.issue.labels.*.name, 'not in English') }}
+    steps:
+      - uses: actions/checkout@v7
+        with:
+          sparse-checkout: .github/scripts
+
+      - name: Check the language
+        id: lang
+        run: echo "result=$(python3 .github/scripts/issue_language.py)" >> "$GITHUB_OUTPUT"
+
+      - name: Close an issue that is not in English
+        if: steps.lang.outputs.result == 'not-english' && env.STATE == 'open'
+        run: |
+          gh label create "$LABEL" --color d4c5f9 --description "Closed until the issue is written in English" 2>/dev/null || true
+          gh issue edit "$NUMBER" --add-label "$LABEL"
+          gh issue close "$NUMBER" --reason "not planned" --comment "Thanks for the report! Issues here are written in English, so that every contributor can read them and search for them. Please edit the title and text of this issue into English - a translator such as DeepL or Google Translate is fine, and logs or game text can stay as they are. The issue opens again by itself once it is in English."
+
+      - name: Reopen an issue edited into English
+        if: steps.lang.outputs.result == 'english' && env.HAS_LABEL == 'true'
+        run: |
+          gh issue edit "$NUMBER" --remove-label "$LABEL"
+          if [ "$STATE" = closed ]; then
+            gh issue reopen "$NUMBER" --comment "Thanks for translating it - the issue is open again."
+          fi
diff --git a/UPSTREAM-REVIEW/upstream-workflows/issue_triage.yml b/UPSTREAM-REVIEW/upstream-workflows/issue_triage.yml
new file mode 100644
index 0000000000000000000000000000000000000000..4ddea0f18f233bfff19b2faceb1fc817a80f58ae
--- /dev/null
+++ b/UPSTREAM-REVIEW/upstream-workflows/issue_triage.yml
@@ -0,0 +1,29 @@
+# A new or edited issue is sorted (see .github/scripts/issue_triage.py): its "What is it
+# about?" answer becomes an `area: ...` label, a new issue gets the milestone of its kind and
+# topic (regressions and crashes v0.1.x), and a crash report is labelled `crash` and, when an
+# open issue already has the same panic, closed as its duplicate. Maintainers move what the
+# guess got wrong; an issue is never given a milestone again once it has one.
+name: Issue triage
+
+on:
+  issues:
+    types:
+      - opened
+      - edited
+
+permissions:
+  issues: write
+
+jobs:
+  triage:
+    runs-on: ubuntu-latest
+    env:
+      GH_TOKEN: ${{ github.token }}
+      GH_REPO: ${{ github.repository }}
+    steps:
+      - uses: actions/checkout@v7
+        with:
+          sparse-checkout: .github/scripts
+
+      - name: Sort the issue
+        run: python3 .github/scripts/issue_triage.py
