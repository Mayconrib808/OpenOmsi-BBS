+        assert!((v.var("flap_pos").unwrap() - 0.3).abs() < 1e-5);
+    }
+
+    #[test]
+    fn revoking_or_timing_out_a_press_does_not_turn_it_into_a_click() {
+        let f = Fixture::new(FLAP);
