+                "passenger exit blocked: id={} reason={} st={} door={:?} next={:?} served={:?} destination={:?} pt={:?} target={:?} entry_open={:?} exit_open={:?}",
+                self.people[i].id, reason, p.st, p.door, reg.next, bn.served,
+                p.dest, p.pt, p.pt_target, bn.entry_open, bn.exit_open);
