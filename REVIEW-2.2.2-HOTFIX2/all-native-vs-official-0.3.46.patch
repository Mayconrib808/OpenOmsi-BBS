++    let (cx, cy) = ((eye.x / TILE_M).floor() as i64, (eye.y / TILE_M).floor() as i64);
++    let half = SLOTS as i64 / 2;
++    (cx - half + 1..=cx + half, cy - half + 1..=cy + half)
++}
