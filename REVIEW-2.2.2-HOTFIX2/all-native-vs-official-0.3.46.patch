+                    }
+                    if let Some(v) = self.net.coop.drive.visitor.as_mut() {
+                        v.seen = now;
+                        v.desk = desk;
+                    }
+                }
+            }
+            Message::Return { token, state } => {
+                let valid = self.net.coop.drive.owner.as_ref().is_some_and(|o| {
+                    o.peer == from
+                        && o.token == token
+                        && o.frozen
+                        && o.uid == state.uid
+                        && o.bus == state.bus
+                });
+                if valid
+                    && state.speed.abs() <= 0.5 / 3.6
+                    && self
+                        .player
+                        .as_mut()
+                        .is_some_and(|p| state.apply(&mut p.vehicle))
