+-            let height=self.people[i].ty.def.seat_height;
+-            let p=self.pax_mut(i).unwrap();p.task=Task::SittingInBus;p.st=0;p.pax_state=2.0;
+-            p.seat_h=seat.height;p.pos=(seat.pos-Vec3::Z*height).as_dvec3();p.yaw=(seat.rot as f64).to_radians();
+-            return true;
+-        }
+-        if let (Some(start),Some(goal))=(start,goal.or(home)) {
