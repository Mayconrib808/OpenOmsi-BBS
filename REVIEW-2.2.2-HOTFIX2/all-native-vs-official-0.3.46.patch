+-    pub fn remove_bcs_inspector(&mut self,id:u32)->bool{
+-        if !self.people.iter().any(|p|p.id==id&&matches!(&p.state,State::Pax(x)if x.inspector)){return false;}
+-        self.transfer_to_responder(id)
