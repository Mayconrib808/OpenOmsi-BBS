+                            (self.sound.audio.as_ref(), old.sounds.take())
+                        {
+                            sounds.stop_all(a);
+                        }
+                        if let Some(h) = self.session.humans.as_mut() {
+                            h.player_bus_swapped(old.uid, p.uid, &mut p.vehicle);
