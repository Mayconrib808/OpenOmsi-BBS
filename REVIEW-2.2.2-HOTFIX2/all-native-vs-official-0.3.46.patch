+    #[test]
+    fn release_only_controls_are_accepted_until_mouse_up() {
+        let f = Fixture::new("{trigger:portinha_off}\n(L.L.released) 1 + (S.L.released)\n{end}\n");
+        let mut v = f.vehicle();
