-                            engine_off: false,
-                        },
-                    )
-                })
-                .collect();
-            let mut run: Vec<(&mut omsi_sim::VehicleInstance, &AiFrame)> = t
-                .cars
-                .iter_mut()
-                .enumerate()
-                .filter_map(|(i, car)| frames.get(&i).map(|f| (&mut car.vehicle, f)))
