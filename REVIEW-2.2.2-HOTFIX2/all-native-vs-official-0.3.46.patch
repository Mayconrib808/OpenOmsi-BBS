+        assert!(!parts[0].contains('|'));
+        let mut inbox = Inbox::default();
+        assert_eq!(inbox.receive(2, &parts[0], 100), Some(m));
+        assert!(inbox.receive(2, "DRV1I 0 2 {}", 200).is_none());
+        assert!(inbox.receive(2, "DRV1I 2 nothex {}", 200).is_none());
