++  let a=(gore as f32+j as f32/4.)*TAU/8.;let b=a+TAU/32.;let r0=ring as f32/3.;let r1=(ring+1)as f32/3.;
++  tri(&mut m,roof(r0,a),roof(r1,a),roof(r1,b),0);if ring>0{tri(&mut m,roof(r0,a),roof(r1,b),roof(r0,b),0);}
