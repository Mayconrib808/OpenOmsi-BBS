+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn bus(id: BusId, y:f64, heading:f64, line:&str) -> Bus {
+        Bus {id,position:DVec3::new(0.0,y,0.0),heading,speed:8.0,line:line_key(line),horn:false,high_beam:false}
