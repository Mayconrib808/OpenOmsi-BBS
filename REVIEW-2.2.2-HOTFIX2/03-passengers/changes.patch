+    std::fs::write(dir.join("vars.txt"),
+        "door_0\ndoor_1\ndoor_2\ndoor_3\ndoor_4\nPAX_Exit0_Open\n").unwrap();
+    std::fs::write(dir.join("main.osc"), "{init}\n{end}\n").unwrap();
