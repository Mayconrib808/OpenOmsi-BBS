+/// Remember one completed request per full bus. A real free place resets it.
+pub struct FullBusHail<K>{seen:Vec<(K,f32)>}
+impl<K> Default for FullBusHail<K>{fn default()->Self{Self{seen:Vec::new()}}}
+impl<K:Copy+Eq> FullBusHail<K>{
+    pub fn allow(&mut self,bus:K,full:bool,active:bool,dt:f32)->bool{
+        if !full{self.seen.retain(|(id,_)|*id!=bus);return true}
+        if let Some((_,elapsed))=self.seen.iter_mut().find(|(id,_)|*id==bus){
+            if active{*elapsed=(*elapsed+dt.clamp(0.,0.25)).min(2.);}
+            return *elapsed<1.4;
+        }
+        if active{
+            if self.seen.len()>=8{self.seen.remove(0);}
+            self.seen.push((bus,dt.clamp(0.,0.25)));
+        }
+        true
+    }
+}
+#[cfg(test)]
