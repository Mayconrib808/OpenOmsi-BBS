+++ b/crates/omsi-sim/src/human/hail_look.rs
@@ -0,0 +1,117 @@
+//! Cosmetic gaze for hailing. Never changes simulation heading, feet or boarding.
+use super::*;
+
+/// Convert an absolute bus position into the person's model frame.
+/// OMSI heading is clockwise from +Y; subtract world coordinates in f64 first.
+pub fn hail_look_target(person:DVec3,heading:f64,bus:DVec3)->Option<Vec3>{
+    let delta=bus-person;
+    if !delta.is_finite() || !heading.is_finite() || delta.truncate().length_squared()<0.01{return None}
+    let (s,c)=heading.to_radians().sin_cos();
+    Some(Vec3::new((c*delta.x-s*delta.y)as f32,(s*delta.x+c*delta.y)as f32,delta.z as f32+1.7))
+}
+
+#[derive(Default)]
+pub struct HailLook { yaw:f32,pitch:f32 }
+impl HailLook{
+    fn step(&mut self,target:Option<Vec3>,dt:f32){
+        let (yaw,pitch)=target.filter(|v|v.is_finite()).map_or((0.,0.),|v|{
+            let mut yaw=-v.x.atan2(v.y);
+            // Keep the previous turn side when a bus crosses directly behind.
+            if v.y<0. && v.x.abs()<v.y.abs()*0.12 && self.yaw.abs()>0.1 {yaw=self.yaw.signum()*PI;}
+            (yaw.clamp(-150f32.to_radians(),150f32.to_radians()),
+             v.z.atan2(v.truncate().length().max(0.1)).clamp(-25f32.to_radians(),25f32.to_radians()))
+        });
+        let dt=if dt.is_finite(){dt.clamp(0.,0.1)}else{0.};
+        let k=1.-(-dt/0.22).exp();
+        self.yaw+=((yaw-self.yaw)*k).clamp(-dt*3.5,dt*3.5);
+        self.pitch+=(pitch-self.pitch)*k;
+    }
+    /// Rotate only the upper body. Arm IK and umbrella placement run afterwards.
+    pub fn advance(&mut self,rig:&Rig,bones:&mut[Affine3A;SLOTS],target:Option<Vec3>,amount:f32,dt:f32){
+        let head=bones[HEAD].transform_point3(rig.head_pivot);
+        self.step(target.map(|v|v-head),dt);
+        let amount=if amount.is_finite(){amount.clamp(0.,1.)}else{0.};
+        if amount<=0.0001{return}
+        let waist=bones[MAIN].transform_point3(rig.waist);
+        let turn=Affine3A::from_translation(waist)
+            *Affine3A::from_quat(Quat::from_rotation_z(self.yaw.clamp(-70f32.to_radians(),70f32.to_radians())*amount))
+            *Affine3A::from_translation(-waist);
+        for slot in [MAIN,HEAD,UPPER[0],UPPER[1],FORE[0],FORE[1],HAND[0],HAND[1]] {bones[slot]=turn*bones[slot];}
+        let pivot=bones[HEAD].transform_point3(rig.head_pivot);
+        let (scale,old,_) = bones[HEAD].to_scale_rotation_translation();
+        let desired=Quat::from_rotation_z(self.yaw)*Quat::from_rotation_x(self.pitch);
+        bones[HEAD]=Affine3A::from_translation(pivot)
+            *Affine3A::from_scale_rotation_translation(scale,old.slerp(desired,amount),Vec3::ZERO)
+            *Affine3A::from_translation(-rig.head_pivot);
+    }
+}
+
+#[cfg(test)]
+mod hail_look_2212_tests{
+    use super::*;
+    #[test] fn omsi_headings_face_the_same_bus_direction(){
+        let at=DVec3::new(1e9,-1e9,25.);
+        for heading in [0f64,90.,180.,270.]{
+            let h=heading.to_radians();
+            let ahead=DVec3::new(h.sin()*40.,h.cos()*40.,0.);
+            let right=DVec3::new(h.cos()*40.,-h.sin()*40.,0.);
+            let f=hail_look_target(at,heading,at+ahead).unwrap();
+            let r=hail_look_target(at,heading,at+right).unwrap();
+            assert!(f.x.abs()<0.001 && f.y>39.9);
+            assert!(r.x>39.9 && r.y.abs()<0.001);
+            let mut look=HailLook::default();
+            for _ in 0..120 {look.step(Some(r),1./60.);}
+            assert!(look.yaw< -1.5 && look.yaw> -1.6);
+        }
+    }
+    #[test] fn behind_is_bounded_stable_and_returns_smoothly(){
+        let mut look=HailLook::default();
+        for _ in 0..200{look.step(Some(Vec3::new(-0.01,-40.,0.)),1./60.);}
+        let before=look.yaw;
+        look.step(Some(Vec3::new(0.01,-40.,0.)),1./60.);
+        assert!(look.yaw>0. && look.yaw<=150f32.to_radians()+0.0001);
+        assert!((look.yaw-before).abs()<0.01);
+        look.step(None,1./60.);assert!(look.yaw>0. && look.yaw<before);
+        for _ in 0..240 {look.step(None,1./60.);}
+        assert!(look.yaw.abs()<0.001);
+    }
+    #[test] fn invalid_target_never_poison_pose(){
+        assert!(hail_look_target(DVec3::ZERO,0.,DVec3::ZERO).is_none());
+        assert!(hail_look_target(DVec3::ZERO,f64::NAN,DVec3::X).is_none());
+        let mut look=HailLook::default();look.step(Some(Vec3::splat(f32::NAN)),f32::NAN);
+        assert!(look.yaw.is_finite() && look.pitch.is_finite());
+    }
+}
