@@ -0,0 +1,54 @@
+//! Small pooled water effects: no per-frame geometry uploads or simulation particles.
+use super::*;
+
+#[derive(Default)]
+pub(super) struct WaterRenders {
+    meshes: Option<(MeshId, MeshId, MaterialId)>,
+    live: HashMap<u32, [usize; 3]>,
+    spare: Vec<[usize; 3]>,
+}
+impl WaterRenders {
+    pub fn retire(&mut self, id: u32, hidden: &mut Vec<usize>) {
+        if let Some(pair) = self.live.remove(&id) { hidden.extend(pair); self.spare.push(pair); }
+    }
+    pub fn rename(&mut self, from: u32, to: u32) {
+        if let Some(pair) = self.live.remove(&from) { self.live.insert(to, pair); }
+    }
+    pub fn hide(&mut self, id: u32, renderer: &Renderer, scene: &mut Scene) {
+        if let Some(pair) = self.live.remove(&id) {
+            for i in pair { renderer.set_params(scene, i, &[], false, &[]); }
+            self.spare.push(pair);
+        }
+    }
+    pub fn draw(&mut self, p: &PersonFrame, st: &State, at: DVec3, xf: Mat4, renderer: &Renderer, scene: &mut Scene) {
+        if st.wetness < 0.05 { self.hide(p.id, renderer, scene); return; }
+        if self.meshes.is_none() {
+            let material = renderer.add_material_extra(scene, None, AlphaMode::Opaque,
+                [0.56, 0.72, 0.79, 1.], false, None, None, None, None, [0.; 3],
+                omsi_render::MaterialExtra { solid: true, ..Default::default() });
+            self.meshes = Some((renderer.add_mesh(scene, &geometry::runoff()), renderer.add_mesh(scene, &geometry::drips()), material));
+        }
+        let (flow, drip, material) = *self.meshes.as_ref().unwrap();
+        let pair = if let Some(pair) = self.live.get(&p.id) { *pair } else {
+            let pair = self.spare.pop().unwrap_or_else(|| [
+                renderer.add_instance(scene, flow, at, Mat4::IDENTITY, vec![material]),
+                renderer.add_instance(scene, flow, at, Mat4::IDENTITY, vec![material]),
+                renderer.add_instance(scene, drip, at, Mat4::IDENTITY, vec![material]),
+            ]);
+            self.live.insert(p.id, pair); pair
+        };
+        let cap_at = at + xf.transform_vector3(st.cap).as_dvec3();
+        for (k, i) in pair[..2].iter().copied().enumerate() {
+            let phase = (st.time * 0.85 + (p.id % 29) as f32 * 0.13 + k as f32 * 0.5).fract();
+            let top = cap_at + xf.transform_vector3(Vec3::Z * 0.014).as_dvec3();
+            renderer.set_transform(scene, i, top, xf * Mat4::from_scale(Vec3::new(
+                phase.max(0.001) * st.size, phase.max(0.001) * st.size, phase.max(0.001).powi(2) * st.size)));
+            renderer.set_params(scene, i, &[], st.open > 0.96 && phase > 0.12, &[]);
+        }
+        let phase = (st.time * 1.6 + (p.id % 31) as f32 * 0.17).fract();
+        let tip = st.cap.z - 0.27 * (1.9 - 0.9 * st.open) * st.size;
+        let position = Vec3::new(st.cap.x, st.cap.y, tip - 0.04 - phase * (tip - 0.25).clamp(0.05, 0.55));
+        renderer.set_transform(scene, pair[2], at + xf.transform_vector3(position).as_dvec3(), xf);
+        renderer.set_params(scene, pair[2], &[], st.open < 0.20 && tip > 0.3, &[]);
+    }
+}
