+mod geometry;
+static RAIN:AtomicBool=AtomicBool::new(false);
+pub(crate) fn weather(w:&omsi_content::weather::Weather){RAIN.store(w.precip.first().copied().unwrap_or(0.).round() as i32==1&&w.precip.get(1).copied().unwrap_or(0.)>2.,Ordering::Relaxed);}
+pub(crate) fn map_key(s:&str)->String{s.replace('\\',"/").trim_end_matches('/').trim_end_matches("/global.cfg").rsplit('/').next().unwrap_or(s).trim().to_lowercase()}
+pub(crate) fn map_enabled(list:&str,map:&str)->bool{let key=map_key(map);list.split(';').any(|s|!s.trim().is_empty()&&map_key(s)==key)}
+#[derive(Clone,Default)]
+pub(crate) struct Config{pub umbrellas:bool,pub hail:bool,pub maps:String}
+impl Config{pub fn of(s:&crate::settings::Settings)->Self{Self{umbrellas:s.passenger_umbrellas,hail:s.passenger_hailing,maps:s.passenger_hailing_maps.clone()}}}
+#[derive(Default)]
+pub(super) struct State{
+ pub open:f32,pub arm:f32,pub hail:f32,pub carried:bool,pub grip:Vec3,pub finger:f32,pub hail_side:usize,
+ wet:f32,dry:f32,pub rest:Option<Arc<HandRest>>,
+}
+pub(super) struct HandVertex{mesh:usize,index:usize,pos:Vec3,nrm:Vec3,point:Vec3,original:Vec3,original_nrm:Vec3,index_finger:bool}
+pub(super) struct HandRest{vertices:[Vec<HandVertex>;2],pub grip:[Vec3;2],knuckle:[Vec3;2]}
+impl HandRest{
+ pub fn new(ty:&HumanType)->Self{
+ let curled=omsi_sim::human::curl_hands(ty,0.008);let grip=grip_centres(ty,0.008);
+ let mut out=Self{vertices:[Vec::new(),Vec::new()],grip:[Vec3::ZERO;2],knuckle:[Vec3::ZERO;2]};
+ for side in 0..2{let w=ty.rig.wrist[side];let u=(w-ty.rig.elbow[side]).normalize_or(Vec3::X);let len=(ty.joints.finger-ty.joints.hand).length().clamp(0.12,0.3);
+ let knuckle=w+u*len*0.53;out.knuckle[side]=knuckle;out.grip[side]=grip[side].unwrap_or(w+u*len*0.5);
+ for (mi,m) in ty.meshes.iter().enumerate(){for(i,inf)in m.skin.iter().enumerate(){
+ if (0..inf.n as usize).any(|k|inf.slot[k] as usize==hand_slot(side)&&inf.weight[k]>0.5){let p=m.data.positions[i];let rel=p-knuckle;
+ // The index is a strip beside the thumb; models without separated fingers retain a hand wave.
+ let across=rel.dot(u.cross(Vec3::Z).normalize_or(Vec3::Y));let index_finger=rel.dot(u)>0.&&across>len*0.02&&across<len*0.19;
+ out.vertices[side].push(HandVertex{mesh:mi,index:i,pos:curled[mi].0[i],nrm:curled[mi].1[i],point:p,original:p,original_nrm:m.data.normals[i],index_finger});
+ }}}
+ }out
+ }
+}
+impl State{
+ pub fn advance(&mut self,p:&PersonFrame,ty:&HumanType,dt:f32,time:f64,c:&Config,enabled:bool,near:bool,hail_map:bool,bones:&mut[Affine3A;omsi_sim::human::SLOTS]){
+ let outside=matches!(p.place,Place::Ground);let ordinary=p.hidden.is_none()&&!p.puppet;
+ let eligible=enabled&&ordinary&&near;let owns=p.id.wrapping_mul(2654435761)%100<65;
+ let raining=RAIN.load(Ordering::Relaxed);
+ if raining{self.wet+=dt;self.dry=0.;}else{self.wet=0.;self.dry+=dt;}
+ if eligible&&c.umbrellas&&owns&&outside&&raining&&self.wet>(p.id%37)as f32*0.08{self.carried=true;}
+ let want_open=eligible&&c.umbrellas&&self.carried&&outside&&!p.close_umbrella&&(raining||self.dry<8.+(p.id%40)as f32*0.15);
+ self.open+=(if want_open{1.}else{0.}-self.open).clamp(-dt*2.5,dt*1.4);
+ if !outside{self.open=0.;}
+ let carry=eligible&&c.umbrellas&&self.carried&&p.facts.activity!=omsi_sim::human::Activity::Sit&&p.facts.activity!=omsi_sim::human::Activity::Pay;
+ self.arm+=(if carry{1.}else{0.}-self.arm).clamp(-dt*3.,dt*3.);
+ if !enabled||!c.umbrellas {self.open=0.;self.arm=0.;}
+ let phase=(time as f32+p.id as f32*0.618).rem_euclid(6.2);
+ let bus_near=p.hail_target.is_some_and(|b|{let d=(b-p.position).length();d>6.&&d<55.});
+ let hail=eligible&&c.hail&&hail_map&&outside&&p.state=="WaitingForBus"&&bus_near&&p.id%3!=0&&phase<3.5;
+ self.hail+=(if hail{1.}else{0.}-self.hail).clamp(-dt*2.8,dt*2.8);
+ if !enabled||!c.hail||!hail_map {self.hail=0.;}
+ self.hail_side=if self.arm>0.05{0}else{1};self.finger=(time as f32*8.+p.id as f32).sin()*0.28;
+ if self.arm>0.001{
+ let wrist=Vec3::new(0.23*ty.rig.scale,0.23*ty.rig.scale,ty.rig.shoulder[1].z-0.25*ty.rig.scale);
+ accessory_arm(&ty.rig,bones,1,wrist,self.arm,true,0.);
+ let rest=self.rest.as_ref().map_or(ty.rig.wrist[1],|r|r.grip[1]);self.grip=bones[hand_slot(1)].transform_point3(rest);
+ }
+ if self.hail>0.001{
+ let side=self.hail_side;let sign=if side==0{-1.}else{1.};let target=Vec3::new(sign*0.28*ty.rig.scale,0.2*ty.rig.scale,ty.rig.head_pivot.z+0.14*ty.rig.scale);
+ accessory_arm(&ty.rig,bones,side,target,self.hail,false,self.finger*0.22);
+ }
+ }
+ pub fn skin(&self,bones:&[Affine3A;omsi_sim::human::SLOTS],skins:&mut[(Vec<Vec3>,Vec<Vec3>)]){
+ let Some(rest)=&self.rest else{return};
+ for side in 0..2{let carry=side==1&&self.arm>0.05;let point=side==self.hail_side&&self.hail>0.05;if !carry&&!point{continue}
+ let b=bones[hand_slot(side)];
+ for v in &rest.vertices[side]{let Some((pos,nrm))=skins.get_mut(v.mesh)else{continue};
+ let (mut p,n)=if point&&v.index_finger{let r=glam::Quat::from_rotation_y(self.finger);(rest.knuckle[side]+r*(v.point-rest.knuckle[side]),r*v.original_nrm)}else{(v.pos,v.nrm)};
+ let blend=if point{self.hail}else{self.arm};p=v.original.lerp(p,blend.clamp(0.,1.));
+ pos[v.index]=b.transform_point3(p);nrm[v.index]=b.transform_vector3(n).normalize_or(Vec3::Z);
+ }
+ }
+ }
+}
+#[derive(Default)]
+pub(super) struct Renders{meshes:Option<(MeshId,MeshId,Vec<MaterialId>,Vec<Vec<MaterialId>>)>,live:HashMap<u32,(usize,usize)>,spare:Vec<(usize,usize)>}
+impl Renders{
+ pub fn retire(&mut self,id:u32,hidden:&mut Vec<usize>){if let Some((a,b))=self.live.remove(&id){hidden.extend([a,b]);self.spare.push((a,b));}}
+ pub fn rename(&mut self,from:u32,to:u32){if let Some(pair)=self.live.remove(&from){self.live.insert(to,pair);}}
+ pub fn draw(&mut self,p:&PersonFrame,st:&State,at:DVec3,xf:Mat4,allowed:bool,renderer:&Renderer,scene:&mut Scene){
+ let show=allowed&&st.arm>0.02&&p.hidden.is_none()&&st.carried;
+ if !show{if let Some((a,b))=self.live.get(&p.id){renderer.set_params(scene,*a,&[],false,&[]);renderer.set_params(scene,*b,&[],false,&[]);}return}
+ if self.meshes.is_none(){
+ let material=|scene:&mut Scene,color:[f32;4]|renderer.add_material_extra(scene,None,AlphaMode::Opaque,color,false,None,None,None,None,[0.;3],omsi_render::MaterialExtra{solid:true,..Default::default()});
+ let metal=material(scene,[0.32,0.34,0.37,1.]);let handle=material(scene,[0.035,0.025,0.02,1.]);
+ let colors=[[0.025,0.028,0.04,1.],[0.025,0.06,0.16,1.],[0.35,0.045,0.15,1.],[0.15,0.055,0.28,1.],[0.65,0.08,0.04,1.],[0.06,0.3,0.12,1.],[0.65,0.4,0.025,1.],[0.025,0.22,0.4,1.]];
+ let mats:Vec<_>=colors.into_iter().map(|c|material(scene,c)).collect();let palettes=(0..5).map(|i|{let mut v=(0..8).map(|j|mats[if i==4{j}else{i}]).collect::<Vec<_>>();v.push(metal);v}).collect();
+ let cap=renderer.add_mesh(scene,&geometry::canopy());let shaft=renderer.add_mesh(scene,&geometry::shaft());self.meshes=Some((cap,shaft,vec![metal,handle],palettes));
+ }
+ let (cap,shaft,body_mats,palettes)=self.meshes.as_ref().unwrap();let palette=(p.id%5)as usize;
