+/// reads it: under 90 (or not a number) 0, the bus's own animation; else rounded and kept
+/// within 180..=1800.
+pub fn cab_wheel_rotation(v: f32) -> u32 {
+    if !v.is_finite() || v < 90.0 {
+        0
+    } else {
+        v.round().clamp(180.0, 1800.0) as u32
+    }
