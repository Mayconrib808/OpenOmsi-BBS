+    /// (the keys' choice stays then).
+    pub(crate) fn hover(&mut self, id: &str, cursor: (f32, f32)) {
+        if self.cursor == Some(cursor) {
+            return;
+        }
+        if let Some(i) = page_tiles(self.page).iter().position(|t| t.0 == id) {
+            self.focus = i;
+            self.cursor = Some(cursor);
+        }
     }
