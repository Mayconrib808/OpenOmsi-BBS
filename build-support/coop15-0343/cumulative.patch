+mod hail_arm_2215_tests {
+    use super::*;
+    fn rig()->Rig {
+        let def=Human {height:1.77,seat_height:0.82,
+            links:vec![0.09,0.,0.92,0.09,-0.03,0.53,0.02,1.17,0.18,-0.05,1.43,0.44,-0.04,1.41,-0.02,1.55,0.69,-0.03,1.43,0.9,-0.03,1.43],
+            walk_param:[1.4,80.,1.,1.,0.],..Default::default()};
+        Rig::measure(&def,&Joints::from_links(&def.links),&[])
+    }
+    #[test] fn hands_face_the_street_after_body_turns_without_stretching_or_twisting(){
+        let r=rig();
+        for degrees in [-150f32,-90.,-35.,0.,35.,90.,150.] {
+            let q=Quat::from_rotation_z(degrees.to_radians());
+            let forward=q*Vec3::Y;
+            for side in 0..2 {
+                let mut bones=[Affine3A::from_quat(q);SLOTS];
+                let old=bones;
+                for wave in [-0.12,0.,0.12] {
+                    accessory_hail_arm(&r,&mut bones,side,forward,1.,wave);
+                    let index=bones[HAND[side]].transform_vector3(r.wrist[side]-r.elbow[side]).normalize();
+                    assert!(index.dot(forward)>0.2,"backwards hand {degrees} side {side}: {index:?}");
+                    let sh=bones[UPPER[side]].transform_point3(r.shoulder[side]);
+                    let el=bones[FORE[side]].transform_point3(r.elbow[side]);
+                    let wr=bones[HAND[side]].transform_point3(r.wrist[side]);
+                    assert!((sh.distance(el)-r.upper_arm).abs()<1e-4);
+                    assert!((el.distance(wr)-r.forearm).abs()<1e-4);
+                    assert!(bones[UPPER[side]].transform_point3(r.elbow[side]).distance(el)<1e-4);
+                    assert!(bones[FORE[side]].transform_point3(r.wrist[side]).distance(wr)<1e-4);
+                    let fore=bones[FORE[side]].to_scale_rotation_translation().1;
+                    let hand=bones[HAND[side]].to_scale_rotation_translation().1;
+                    let angle=(fore.conjugate()*hand).to_axis_angle().1.abs();
+                    assert!(angle.min((TAU-angle).abs())<=55f32.to_radians()+1e-4);
+                    for slot in 0..SLOTS {
+                        if ![UPPER[side],FORE[side],HAND[side]].contains(&slot) {assert!(bones[slot].abs_diff_eq(old[slot],1e-6));}
+                    }
+                    assert!(bones.iter().all(|b|b.is_finite()));
+                }
+            }
+        }
+    }
+    #[test] fn disabled_and_invalid_targets_preserve_the_original_pose(){
+        let r=rig();
+        for (dir,amount) in [(Vec3::Y,0.),(Vec3::Y,f32::NAN),(Vec3::ZERO,1.),(Vec3::splat(f32::NAN),1.)] {
+            let mut bones=[Affine3A::IDENTITY;SLOTS];
+            accessory_hail_arm(&r,&mut bones,0,dir,amount,f32::NAN);
+            assert!(bones.iter().all(|b|b.abs_diff_eq(Affine3A::IDENTITY,1e-6)));
+        }
