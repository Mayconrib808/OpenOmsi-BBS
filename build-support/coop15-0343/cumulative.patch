+        ] {
+            v.position = position;
+            v.heading = heading;
+            let actual = camera_pose(&v, &cam, (179.0, 0.0), (179.0, 0.0));
+            let expected = v.camera_world_full(&cam);
+            assert!((actual.0 - expected.0).length() < 1e-6);
+            assert!((actual.1 - expected.1).abs() < 1e-5);
+            let rear = position
+                + v.body_rotation()
+                    .transform_point3(Vec3::new(0.0, -4.0, 1.2))
+                    .as_dvec3();
