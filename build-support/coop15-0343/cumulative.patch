+pub(super) const VISUAL_DISTANCE_SQ:f64=300.*300.;
+static RAIN:AtomicBool=AtomicBool::new(false);
+pub(crate) fn weather(w:&omsi_content::weather::Weather){RAIN.store(w.precip.first().copied().unwrap_or(0.).round() as i32==1&&w.precip.get(1).copied().unwrap_or(0.)>0.,Ordering::Relaxed);}
+pub(crate) fn map_key(s:&str)->String{omsi_launcher_lib::passenger_defaults::map_key(s)}
+pub(crate) fn map_enabled(list:&str,map:&str)->bool{let key=map_key(map);list.split(';').any(|s|!s.trim().is_empty()&&map_key(s)==key)}
+#[derive(Clone,Default)]
+pub(crate) struct Config{pub umbrellas:bool,pub hail:bool,pub maps:String}
+impl Config{pub fn of(s:&crate::settings::Settings)->Self{Self{umbrellas:s.passenger_umbrellas,hail:s.passenger_hailing,maps:s.passenger_hailing_maps.clone()}}}
+#[derive(Default)]
+pub(super) struct State{
+ look:omsi_sim::human::HailLook,
+ full_gate:omsi_sim::human::FullBusHail<omsi_sim::people::BusId>,
+ pub open:f32,pub arm:f32,pub hail:f32,pub carried:bool,pub grip:Vec3,pub finger:f32,pub hail_side:usize,
+ wet:f32,pub wetness:f32,pub time:f32,pub cap:Vec3,pub size:f32,pub raise:f32,pub cap_rotation:Quat,initialized:bool,pub rest:Option<Arc<HandRest>>,
+}
+pub(super) struct HandVertex{mesh:usize,index:usize,pos:Vec3,nrm:Vec3,point:Vec3,original:Vec3,original_nrm:Vec3,index_finger:bool}
+pub(super) struct HandRest{vertices:[Vec<HandVertex>;2],pub grip:[Vec3;2],knuckle:[Vec3;2],finger_axis:[Vec3;2]}
+impl HandRest{
+ pub fn new(ty:&HumanType)->Self{
+ let curled=omsi_sim::human::curl_hands(ty,0.008);let grip=grip_centres(ty,0.008);
+ let mut out=Self{vertices:[Vec::new(),Vec::new()],grip:[Vec3::ZERO;2],knuckle:[Vec3::ZERO;2],finger_axis:[Vec3::Y;2]};
+ for side in 0..2{let w=ty.rig.wrist[side];let u=(w-ty.rig.elbow[side]).normalize_or(Vec3::X);let len=(ty.joints.finger-ty.joints.hand).length().clamp(0.12,0.3);
+ let knuckle=w+u*len*0.53;out.knuckle[side]=knuckle;out.grip[side]=grip[side].unwrap_or(w+u*len*0.5);
+ // Use the same palm/thumbnail side convention as native curl_hands.
+ let axis=u.cross(-Vec3::Z).normalize_or(Vec3::Y);
+ let sign=if side==0{-1.}else{1.};out.finger_axis[side]=axis;
+ let mut index_edge=f32::NEG_INFINITY;
+ for m in &ty.meshes {for (i,inf) in m.skin.iter().enumerate(){
+   let rel=m.data.positions[i]-knuckle;
+   if rel.dot(u)>len*0.12 && (0..inf.n as usize).any(|k|inf.slot[k]as usize==hand_slot(side)&&inf.weight[k]>0.5){
+      index_edge=index_edge.max(rel.dot(axis)*sign);
+   }
+ }}
+ for (mi,m) in ty.meshes.iter().enumerate(){for(i,inf)in m.skin.iter().enumerate(){
+ if (0..inf.n as usize).any(|k|inf.slot[k] as usize==hand_slot(side)&&inf.weight[k]>0.5){let p=m.data.positions[i];let rel=p-knuckle;
