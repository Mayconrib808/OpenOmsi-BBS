+ if !show{self.water.hide(p.id,renderer,scene);if let Some((a,b))=self.live.remove(&p.id){renderer.set_params(scene,a,&[],false,&[]);renderer.set_params(scene,b,&[],false,&[]);self.spare.push((a,b));}return}
