+//! Local visual arm IK for optional passenger accessories (no simulation state).
+use super::*;
+
+/// The actual posed head top, including the model's height and head movement.
+pub fn accessory_head(rig: &Rig, bones: &[Affine3A; SLOTS]) -> Vec3 {
+    bones[HEAD].transform_point3(Vec3::new(rig.head_pivot.x, rig.head_pivot.y, rig.head_top))
+}
+
+pub fn accessory_arm(rig: &Rig, bones: &mut [Affine3A; SLOTS], side: usize, target: Vec3, amount: f32, grip: bool, wave: f32) {
+    let side=side.min(1);
+    let sh=bones[MAIN].transform_point3(rig.shoulder[side]);
+    let old=bones[HAND[side]].transform_point3(rig.wrist[side]);
+    let target=old.lerp(target,amount.clamp(0.0,1.0));
+    let pole=Vec3::new(SIDE[side]*0.75,-0.2,-0.8);
+    let (el,wr,_)=two_bone(sh,rig.upper_arm,rig.forearm,target,pole);
+    let a=(el-sh).normalize_or(-Vec3::Z);
+    let c=(wr-el).normalize_or(-Vec3::Z);
+    let front=(c-a*a.dot(c)).normalize_or(Vec3::Y);
+    let bend=a.dot(c).clamp(-1.0,1.0).acos();
+    let fore_front=front*bend.cos()-a*bend.sin();
+    let upper=bone_rot(rig.elbow[side]-rig.shoulder[side],Vec3::Y,a,front);
+    let fore=bone_rot(rig.wrist[side]-rig.elbow[side],Vec3::Y,c,fore_front);
+    // Hold the shaft upright: the rest fingers point along X, palm towards -Z.
+    let hand=if grip { bone_rot(rig.wrist[side]-rig.elbow[side],-Vec3::Z,Vec3::Y,Vec3::X*SIDE[side]) }
+        else { fore*Mat3A::from_rotation_y(wave) };
+    bones[UPPER[side]]=joint_xf(rig.shoulder[side],sh,upper);
+    bones[FORE[side]]=joint_xf(rig.elbow[side],el,fore);
+    bones[HAND[side]]=joint_xf(rig.wrist[side],wr,hand);
+}
+
+/// Hail towards the approaching bus in the same model frame as the posed body.
+/// Leave the umbrella grip and head/torso/leg bones alone.
+pub fn accessory_hail_arm(rig: &Rig, bones: &mut [Affine3A; SLOTS], side: usize, direction: Vec3, amount: f32, wave: f32) {
+    let amount=if amount.is_finite(){amount.clamp(0.,1.)}else{0.};
+    if amount<=0.0001 {return}
+    let side=side.min(1);
+    let forward=Vec3::new(direction.x,direction.y,0.);
+    if !forward.is_finite() || forward.length_squared()<1e-6 {return}
+    let forward=forward.normalize();
+    let right=forward.cross(Vec3::Z);
+    let scale=rig.scale.clamp(0.55,1.5);
+    let wave=if wave.is_finite(){wave.clamp(-0.12,0.12)}else{0.};
+    let sh=bones[MAIN].transform_point3(rig.shoulder[side]);
+    let old_el=bones[FORE[side]].transform_point3(rig.elbow[side]);
+    let old_wr=bones[HAND[side]].transform_point3(rig.wrist[side]);
+    let target=accessory_head(rig,bones)+forward*(0.23*scale)
+        +right*(SIDE[side]*0.21*scale)+Vec3::Z*((0.03+wave*0.15)*scale);
+    let target=old_wr.lerp(target,amount);
+    let old_pole=old_el-(sh+old_wr)*0.5;
+    let pole=old_pole.lerp(right*(SIDE[side]*0.75)-forward*0.15-Vec3::Z*0.25,amount);
+    let (el,wr,_)=two_bone(sh,rig.upper_arm,rig.forearm,target,pole);
+    let a=(el-sh).normalize_or(-Vec3::Z);
+    let c=(wr-el).normalize_or(-Vec3::Z);
+    let front=(c-a*a.dot(c)).normalize_or(forward);
+    let bend=a.dot(c).clamp(-1.,1.).acos();
+    let fore_front=front*bend.cos()-a*bend.sin();
+    let upper=bone_rot(rig.elbow[side]-rig.shoulder[side],Vec3::Y,a,front);
+    let fore=bone_rot(rig.wrist[side]-rig.elbow[side],Vec3::Y,c,fore_front);
+    // Retain the forearm's twist and limit the wrist to 55 degrees.
+    let desired=(forward+Vec3::Z*(0.3+wave)).normalize();
+    let turn=Quat::from_rotation_arc(c,desired);
+    let angle=turn.to_axis_angle().1.abs();
+    let share=(55f32.to_radians()/angle.max(1e-6)).min(1.)*amount;
+    let hand=Mat3A::from_quat(Quat::IDENTITY.slerp(turn,share))*fore;
+    bones[UPPER[side]]=joint_xf(rig.shoulder[side],sh,upper);
+    bones[FORE[side]]=joint_xf(rig.elbow[side],el,fore);
+    bones[HAND[side]]=joint_xf(rig.wrist[side],wr,hand);
+}
