+ let colors=[[0.025,0.028,0.04,1.],[0.025,0.06,0.16,1.],[0.35,0.045,0.15,1.],[0.15,0.055,0.28,1.],[0.65,0.08,0.04,1.],[0.06,0.3,0.12,1.],[0.65,0.4,0.025,1.],[0.025,0.22,0.4,1.]];
