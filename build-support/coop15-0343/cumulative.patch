+//! One persistent appearance per player, whether driver, conductor or pedestrian.
+pub(crate) mod catalog;
+use catalog::{Choice, Preference};
+use crate::{App, driver};
+use omsi_sim::human::HumanType;
+use std::path::{Path, PathBuf};
+use std::sync::Arc;
+
+pub(crate) struct CharacterState {
+    pub open: bool,
+    pub choices: Vec<Choice>,
+    pub query: String,
+    pub page: usize,
+    pub chosen: String,
+    pub error: String,
+    applied_driver: Option<(u64, String)>,
+}
+
+impl Default for CharacterState {
+    fn default() -> Self {
+        Self { open:false, choices:Vec::new(), query:String::new(), page:0,
+            chosen:catalog::saved_choice().unwrap_or_default(), error:String::new(),
+            applied_driver:None }
+    }
+}
+
+fn resolve(root: &Path, relative: &str) -> Option<PathBuf> {
+    let relative=catalog::normalize(relative)?;
+    omsi_cfg::find_in_roots(&relative).map(|(_,path)|path).or_else(|| {
+        let path=omsi_cfg::resolve_path(root,&relative);
+        omsi_cfg::vfs::is_file(&path).then_some(path)
+    })
+}
+
+pub(crate) fn preferred_type(root: &Path) -> Option<Arc<HumanType>> {
+    catalog::saved_choice().and_then(|s|resolve(root,&s)).and_then(|p|driver::cached_type(&p))
+}
+
+pub(crate) fn saved_choice() -> Option<String> { catalog::saved_choice() }
+
+impl App {
+    pub(crate) fn character_open(&mut self) {
+        let mut roots=omsi_cfg::content_dirs("Humans");
+        let own=omsi_cfg::resolve_path(&self.args.root,"Humans");
+        if omsi_cfg::vfs::is_dir(&own) && !roots.contains(&own) { roots.push(own); }
+        let state=&mut self.net.coop.character;
+        state.choices=catalog::scan(&roots);
+        state.page=0;
+        state.error.clear();
+        state.open=true;
+        self.net.coop.panel=true;
+    }
+
+    pub(crate) fn character_choose(&mut self, chosen: &str) {
+        let chosen=if chosen.is_empty() {String::new()} else {
+            let Some(file)=catalog::normalize(chosen) else {return};
+            file
+        };
+        let ty=if chosen.is_empty() {None} else {
+            let Some(ty)=resolve(&self.args.root,&chosen).and_then(|p|driver::cached_type(&p)) else {
+                self.net.coop.character.error=crate::coop::text(
+                    "Este personagem não pôde ser carregado. A escolha anterior foi mantida.",
+                    "This character could not be loaded. Your previous choice was kept.",
+                    "Diese Figur konnte nicht geladen werden. Die bisherige Auswahl bleibt.").into();
+                return;
+            };
+            Some(ty)
+        };
+        let result=catalog::preference_path().ok_or_else(||std::io::Error::new(
+            std::io::ErrorKind::NotFound,"User profile unavailable"))
+            .and_then(|path|Preference {character:chosen.clone()}.save(&path));
+        if result.is_err() {
+            self.net.coop.character.error=crate::coop::text(
+                "Não foi possível salvar a escolha no seu perfil.",
+                "Could not save the choice in your profile.",
+                "Die Auswahl konnte nicht im Profil gespeichert werden.").into();
+            return;
+        }
+        let state=&mut self.net.coop.character;
+        state.chosen=chosen;
+        state.error.clear();
+        let actual=ty.or_else(||self.world.as_deref().and_then(|w|driver::driver_type(w,0)));
+        if let (Some(ty),Some(h),Some(foot))=(actual,self.session.humans.as_mut(),self.session.on_foot.as_mut()) {
+            foot.kind=h.type_index(ty) as u64;
+            h.avatar_remove(crate::on_foot::AVATAR_KEY);
+        }
+        self.character_sync();
+    }
+
+    /// Reapply when taking another bus; only the picture changes, never the vehicle.
+    pub(crate) fn character_sync(&mut self) {
+        let Some(p)=self.player.as_ref() else {return};
+        let borrowed = if self.net.coop.drive.owner_active() {
+            self.drive_peer().and_then(|peer| {
+                self.net.lan.as_ref()?.peers()
+                    .find(|p| p.pose.id == peer)
+                    .and_then(|p| omsi_net::human_path(&p.pose.figure))
+            })
+        } else { None };
+        let key=(p.uid, borrowed.unwrap_or_else(|| self.net.coop.character.chosen.clone()));
+        if self.net.coop.character.applied_driver.as_ref()==Some(&key) {return};
+        let (Some(world),Some(renderer),Some(scene))=(self.world.as_deref(),self.renderer.as_ref(),self.scene.as_mut()) else {return};
+        let chosen=(!key.1.is_empty()).then_some(key.1.as_str());
+        let p=self.player.as_mut().unwrap();
+        let expected=chosen.and_then(|s|resolve(&self.args.root,s)).and_then(|p|driver::cached_type(&p))
+            .or_else(||driver::driver_type(world,0));
+        if p.driver.as_ref().zip(expected.as_ref()).is_some_and(|(d,ty)|d.human_type().def.path==ty.def.path) {
+            self.net.coop.character.applied_driver=Some(key);
+            return;
+        }
+        let new=driver::DriverFigure::new_named(world,renderer,scene,&p.vehicle,chosen,0);
+        if let Some(new) = new {
+            if let Some(mut old)=p.driver.take() {old.hide(renderer,scene);}
+            p.driver=Some(new);
+            self.net.coop.character.applied_driver=Some(key);
+        }
+    }
+
+    /// The real on-foot type is also sent when this player owns no vehicle.
+    pub(crate) fn character_figure(&self) -> Option<PathBuf> {
+        let walking=self.session.on_foot.as_ref().and_then(|f| {
+            let humans=self.session.humans.as_ref()?;
+            let n=humans.types.len();
+            if n==0 {return None};
+            humans.types.get((f.kind % n as u64) as usize).map(|ty|ty.def.path.clone())
+        });
+        walking.or_else(||self.player.as_ref().and_then(|p|p.driver.as_ref()).map(|d|d.human_type().def.path.clone()))
+    }
+}
+
diff --git a/crates/omsi-app/src/coop_character/catalog.rs b/crates/omsi-app/src/coop_character/catalog.rs
new file mode 100644
index 00000000..4573f2f5
--- /dev/null
+++ b/crates/omsi-app/src/coop_character/catalog.rs
@@ -0,0 +1,139 @@
+//! Installed character choices and the persistent local choice, shared by all roles.
+use serde::{Deserialize, Serialize};
+use std::collections::HashSet;
+use std::path::{Path, PathBuf};
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct Choice {
+    pub file: String,
+    pub label: String,
+}
+
+#[derive(Default, Deserialize, Serialize)]
+pub struct Preference {
+    pub character: String,
+}
+
+/// The same relative .hum name that the existing protocol can carry.
+pub fn normalize(text: &str) -> Option<String> {
+    let name = text.trim().replace('\\', "/");
+    if name.is_empty() || name.len() > 260 || name.starts_with('/')
+        || name.chars().any(|c| c == ':' || c == '|' || c.is_control())
+        || name.split('/').any(|s| s.trim_matches(|c| c == '.' || c == ' ').is_empty())
+        || !name.split('/').next()?.eq_ignore_ascii_case("humans")
+        || !name.to_ascii_lowercase().ends_with(".hum") {
+        return None;
+    }
+    Some(name)
+}
+
+impl Preference {
+    pub fn load(path: &Path) -> Self {
+        std::fs::read(path).ok()
+            .and_then(|bytes| serde_json::from_slice::<Self>(&bytes).ok())
+            .map(|p| Self { character: normalize(&p.character).unwrap_or_default() })
+            .unwrap_or_default()
+    }
+
+    pub fn save(&self, path: &Path) -> std::io::Result<()> {
+        if !self.character.is_empty() && normalize(&self.character).is_none() {
+            return Err(std::io::Error::new(std::io::ErrorKind::InvalidInput, "Invalid character"));
+        }
+        if let Some(parent) = path.parent() { std::fs::create_dir_all(parent)?; }
+        std::fs::write(path, serde_json::to_vec_pretty(self)?)
+    }
+}
+
+pub fn preference_path() -> Option<PathBuf> {
+    let user = std::env::var_os("USERPROFILE").or_else(|| std::env::var_os("HOME"))?;
+    Some(PathBuf::from(user).join(".openomsi").join("coop-character.json"))
+}
+
+pub fn saved_choice() -> Option<String> {
+    let p = preference_path().map(|p| Preference::load(&p)).unwrap_or_default();
+    (!p.character.is_empty()).then_some(p.character)
+}
+
+/// Roots are priority ordered, so a mod shadowing a stock file appears once.
+pub fn scan(roots: &[PathBuf]) -> Vec<Choice> {
+    let mut found = Vec::new();
+    let mut seen = HashSet::new();
+    for root in roots {
+        let mut stack = vec![(root.clone(), String::from("Humans"), 0usize)];
+        while let Some((dir, relative, depth)) = stack.pop() {
+            if depth > 16 || found.len() >= 20_000 { continue; }
+            let mut entries = omsi_cfg::vfs::list_dir(&dir).unwrap_or_default();
+            entries.sort_by_key(|(n, _)| n.to_string_lossy().to_lowercase());
+            for (name, is_dir) in entries.into_iter().rev() {
+                let name = name.to_string_lossy();
+                if name.contains('/') || name.contains('\\') { continue; }
+                let rel = format!("{relative}/{name}");
+                if is_dir {
+                    stack.push((dir.join(name.as_ref()), rel, depth + 1));
+                } else if let Some(file) = normalize(&rel) {
+                    if seen.insert(file.to_lowercase()) {
+                        let label = file.strip_prefix("Humans/").unwrap_or(&file)
+                            .strip_suffix(".hum").unwrap_or(&file).replace('/', " / ");
+                        found.push(Choice { file, label });
+                    }
+                }
+            }
+        }
+    }
+    found.sort_by_key(|c| c.label.to_lowercase());
+    found
+}
+
+pub fn matches(choice: &Choice, query: &str) -> bool {
+    choice.label.to_lowercase().contains(&query.trim().to_lowercase())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn temporary() -> PathBuf {
+        let dir = std::env::temp_dir().join(format!("coop-character-{}-{}", std::process::id(),
+            std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap().as_nanos()));
+        std::fs::create_dir_all(&dir).unwrap();
+        dir
+    }
+    #[test]
+    fn only_installed_relative_human_names_are_accepted() {
+        assert_eq!(normalize("Humans\\Pessoas BR\\Mulher.hum").unwrap(), "Humans/Pessoas BR/Mulher.hum");
+        for bad in ["../x.hum", "Humans/../x.hum", "Humans/.../x.hum", "C:/Humans/x.hum",
+            "/Humans/x.hum", "Humans//x.hum", "Vehicles/x.hum", "Humans/x.bus",
+            "Humans/x.hum|INFO", "Humans/x\n.hum", "\\\\server\\Humans\\x.hum"] {
+            assert!(normalize(bad).is_none(), "{bad:?}");
+        }
+    }
+    #[test]
+    fn catalog_has_passengers_and_drivers_in_nested_folders_without_duplicates() {
+        let dir = temporary();
+        let high = dir.join("mod");
+        let low = dir.join("stock");
+        for (root, name) in [(&high,"Pack/Mulher.hum"),(&low,"pack/mulher.hum"),
+            (&low,"Pack/Driver.hum"),(&low,"Pack/Nested/Cobrador.HUM"),(&low,"Pack/ignore.txt")] {
+            let file=root.join(name);
+            std::fs::create_dir_all(file.parent().unwrap()).unwrap();
+            std::fs::write(file, b"human").unwrap();
+        }
+        let choices=scan(&[high,low]);
+        assert_eq!(choices.len(),3);
+        assert!(choices.iter().any(|c|c.file=="Humans/Pack/Mulher.hum"));
+        assert!(choices.iter().any(|c|matches(c,"cobrador")));
+        std::fs::remove_dir_all(dir).unwrap();
+    }
+    #[test]
+    fn choosing_and_resetting_a_character_survive_a_restart() {
+        let dir=temporary();
+        let path=dir.join("profile/coop-character.json");
+        Preference {character:"Humans/Other/woman01.hum".into()}.save(&path).unwrap();
+        assert_eq!(Preference::load(&path).character,"Humans/Other/woman01.hum");
+        Preference::default().save(&path).unwrap();
+        assert!(Preference::load(&path).character.is_empty());
+        std::fs::write(&path,br#"{"character":"../private.hum"}"#).unwrap();
+        assert!(Preference::load(&path).character.is_empty());
+        std::fs::remove_dir_all(dir).unwrap();
+    }
+}
+
diff --git a/crates/omsi-app/src/coop_drive.rs b/crates/omsi-app/src/coop_drive.rs
new file mode 100644
index 00000000..0710ce2a
--- /dev/null
+++ b/crates/omsi-app/src/coop_drive.rs
@@ -0,0 +1,1189 @@
+//! Full local vehicle authority. The original owner keeps a passive BCS/passenger
+//! proxy; the visiting driver owns scripts, physics, normal input, picking and cameras.
+use crate::{humans::BusId, App, Args, Player, World};
+use omsi_lan::vehicle_transfer::{Message, Snapshot};
+use std::{
+    collections::{HashMap, HashSet},
+    sync::{mpsc, Arc},
+    time::{Duration, Instant, SystemTime, UNIX_EPOCH},
+};
+use winit::keyboard::KeyCode;
+pub(crate) const DRIVER_SEAT: u16 = 1023;
+struct Owner {
+    peer: u32,
+    token: u64,
+    uid: u64,
+    bus: String,
+    frozen: bool,
+    active: bool,
+    seen: Instant,
+    sent: Instant,
+    triggers: Vec<String>,
+    motion: Option<Motion>,
+}
+struct Motion {
+    from: (glam::DVec3, f64, f32, f32),
+    to: (glam::DVec3, f64, f32, f32),
+    started: Instant,
+}
+impl Motion {
+    fn apply(&self, vehicle: &mut omsi_sim::VehicleInstance) {
+        self.apply_elapsed(vehicle, self.started.elapsed().as_secs_f64());
+    }
+    fn apply_elapsed(&self, vehicle: &mut omsi_sim::VehicleInstance, elapsed: f64) {
+        let t = (elapsed / 0.1).clamp(0.0, 1.0);
+        vehicle.position = self.from.0.lerp(self.to.0, t);
+        vehicle.heading = self.from.1 + ((self.to.1-self.from.1+180.0).rem_euclid(360.0)-180.0)*t;
+        vehicle.pitch = self.from.2 + (self.to.2-self.from.2)*t as f32;
+        vehicle.bank = self.from.3 + (self.to.3-self.from.3)*t as f32;
+    }
+}
+struct Visitor {
+    owner: u32,
+    token: u64,
+    uid: u64,
+    bus: String,
+    args: Args,
+    world: Arc<World>,
+    loading: Option<mpsc::Receiver<anyhow::Result<crate::spawn::PreparedPlayer>>>,
+    prepared: Option<crate::spawn::PreparedPlayer>,
+    parked: Option<u64>,
+    foot: Option<crate::on_foot::OnFoot>,
+    active: bool,
+    returning: bool,
+    actors: HashSet<u32>,
+    desk: u32,
+    seen: Instant,
+    sent: Instant,
+    started: Instant,
+}
+#[derive(Default)]
+pub(crate) struct DriveState {
+    requests: HashMap<u32, (u64, Instant)>,
+    request: Option<(u32, u64, Instant)>,
+    owner: Option<Owner>,
+    visitor: Option<Visitor>,
+}
+impl DriveState {
+    pub(crate) fn owner_active(&self) -> bool {
+        self.owner.as_ref().is_some_and(|o| o.frozen)
+    }
+    pub(crate) fn visitor_active(&self) -> bool {
+        self.visitor.as_ref().is_some_and(|v| v.active)
+    }
+    pub(crate) fn busy(&self) -> bool {
+        self.owner.is_some() || self.visitor.is_some()
+    }
+    pub(crate) fn visitor_owner(&self) -> Option<u32> {
+        self.visitor.as_ref().filter(|v| v.active).map(|v| v.owner)
+    }
+}
+fn nonce() -> u64 {
+    SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .map_or(1, |d| d.as_nanos() as u64)
+        .max(1)
+}
+fn bus_name(app: &App, p: &Player) -> String {
+    let file = &p.vehicle.ty.def.path;
+    omsi_cfg::content_roots()
+        .iter()
+        .chain(std::iter::once(&app.args.root))
+        .find_map(|r| file.strip_prefix(r).ok())
+        .unwrap_or(file)
+        .to_string_lossy()
+        .replace('\\', "/")
+}
+impl App {
+    fn drive_send(&mut self, to: u32, message: Message) {
+        if let (Some(lan), Some(bytes)) = (
+            self.net.lan.as_mut(),
+            omsi_lan::vehicle_transfer::encode(&message),
+        ) {
+            lan.publish_handover(to, bytes);
+        }
+    }
+    pub(crate) fn drive_requested(&self, p: u32) -> bool {
+        self.net
+            .coop
+            .drive
+            .requests
+            .get(&p)
+            .is_some_and(|(_, t)| t.elapsed() < Duration::from_secs(30))
+    }
+    pub(crate) fn drive_peer(&self) -> Option<u32> {
+        self.net.coop.drive.owner.as_ref().map(|o| o.peer)
+    }
+    pub(crate) fn drive_request(&mut self) {
+        if self.net.coop.drive.busy() {
+            return;
+        }
+        let Some(BusId::Ai(id)) = self.foot_bus() else {
+            return;
+        };
+        let Some(owner) = crate::humans::remote_bus_player(id) else {
+            return;
+        };
+        let n = nonce();
+        self.net.coop.drive.request = Some((owner, n, Instant::now()));
+        self.drive_send(owner, Message::Request { nonce: n });
+        self.coop_notice(
+            "Pedido de direção enviado. Aguarde a autorização e o carregamento do ônibus.",
+            "Driver request sent. Waiting for authorization and the full vehicle.",
+            "Fahreranfrage gesendet. Auf Freigabe und vollständiges Fahrzeug warten.",
+        );
+    }
+    pub(crate) fn drive_grant(&mut self, peer: u32) {
+        if self.net.coop.drive.busy()
+            || !self.drive_requested(peer)
+            || !self.coop_peer_inside(peer, omsi_lan::coop::Target::Player)
+        {
+            return;
+        }
+        let Some(p) = self.player.as_ref() else {
+            return;
+        };
+        if p.vehicle.physics.velocity_kmh().abs() > 0.5 {
+            return;
+        }
+        let request = self.net.coop.drive.requests[&peer].0;
+        let token = nonce();
+        let uid = p.uid;
+        let now = Instant::now();
+        let bus = bus_name(self, p);
+        let hof = p
+            .vehicle
+            .host
+            .hof
+            .as_ref()
+            .and_then(|h| h.path.file_stem())
+            .map(|s| s.to_string_lossy().to_string());
+        let paint = p
+            .vehicle
+            .host
+            .paint_scheme
+            .flatten()
+            .and_then(|i| p.vehicle.ty.paint_schemes.get(i))
+            .map(|s| s.name.clone());
+        self.net.coop.drive.owner = Some(Owner {
+            peer,
+            token,
+            uid,
+            bus: bus.clone(),
+            frozen: false,
+            active: false,
+            seen: now,
+            sent: now,
+            triggers: Vec::new(),
+            motion: None,
+        });
+        self.drive_send(
+            peer,
+            Message::Offer {
+                nonce: request,
+                token,
+                uid,
+                bus,
+                hof,
+                paint,
+            },
+        );
+    }
+    pub(crate) fn drive_return(&mut self) {
+        if let Some(o) = self.net.coop.drive.owner.as_ref() {
+            if self
+                .player
+                .as_ref()
+                .is_some_and(|p| p.vehicle.physics.velocity_kmh().abs() <= 0.5)
+            {
+                self.drive_send(o.peer, Message::Abort { token: o.token });
+            } else {
+                self.coop_notice(
+                    "Pare o ônibus antes de retomar a direção.",
+                    "Stop before taking the wheel back.",
+                    "Vor der Rücknahme anhalten.",
+                );
+            }
+            return;
+        }
+        let Some(mut v) = self.net.coop.drive.visitor.take() else {
+            return;
+        };
+        if v.active && !v.returning {
+            if let Some(p) = self.player.as_mut() {
+                if p.vehicle.physics.velocity_kmh().abs() > 0.5 {
+                    self.net.coop.drive.visitor = Some(v);
+                    self.coop_notice(
+                        "Pare o ônibus antes de devolver a direção.",
+                        "Stop before returning the wheel.",
+                        "Vor der Rückgabe anhalten.",
+                    );
+                    return;
+                }
+                p.release();
+                p.authority_remote = true;
+                let state = Snapshot::capture(v.uid, v.bus.clone(), &p.vehicle);
+                v.returning = true;
+                self.drive_send(
+                    v.owner,
+                    Message::Return {
+                        token: v.token,
+                        state,
+                    },
+                );
+            }
+        }
+        self.net.coop.drive.visitor = Some(v);
+    }
+    pub(crate) fn drive_reset(&mut self, notify: bool) {
+        if let Some(o) = self.net.coop.drive.owner.take() {
+            if notify {
+                self.drive_send(o.peer, Message::Abort { token: o.token });
+            }
+            if let Some(p) = self.player.as_mut().filter(|p| p.uid == o.uid) {
+                p.authority_remote = false;
+                p.release();
+                p.axes.throttle = 0.;
+                p.axes.brake = 1.;
+                p.analog = Default::default();
+            }
+            if o.frozen {
+                self.session.on_foot = None;
+                if let Some(h) = self.session.humans.as_mut() {
+                    h.avatar_remove(crate::on_foot::AVATAR_KEY);
+                }
+                self.view = "driver".into();
+                self.cam.look = (0., 0.);
+                self.net.inside_remote = None;
+                self.menus.hover_key = None;
+                if let (Some(p), Some(cam)) = (self.player.as_ref(), self.camera.as_ref()) {
+                    self.camera = Some(p.camera(&self.view, cam));
+                }
+            }
+        }
+        if let Some(mut v) = self.net.coop.drive.visitor.take() {
+            if notify {
+                if v.active {
+                    if let Some(p) = self.player.as_mut() {
+                        p.authority_remote = true;
+                        p.release();
+                        let state = Snapshot::capture(v.uid, v.bus.clone(), &p.vehicle);
+                        self.drive_send(
+                            v.owner,
+                            Message::Suspended {
+                                token: v.token,
+                                state,
+                            },
+                        );
+                    }
+                } else {
+                    self.drive_send(v.owner, Message::Returned { token: v.token });
+                }
+            }
+            if v.active {
+                let borrowed_uid = self.player.as_ref().map_or(0, |p| p.uid);
+                if let Some(mut p) = self.player.take() {
+                    if let (Some(a), Some(mut s)) = (self.sound.audio.as_ref(), p.sounds.take()) {
+                        s.stop_all(a);
+                    }
+                    if let (Some(w), Some(r), Some(scene)) = (
+                        self.world.as_ref(),
+                        self.renderer.as_ref(),
+                        self.scene.as_mut(),
+                    ) {
+                        if let Some(mut d) = p.driver.take() {
+                            d.hide(r, scene);
+                        }
+                        w.release_vehicle(r, scene, p.render);
+                        for t in p.trailer_renders {
+                            w.release_vehicle(r, scene, t);
+                        }
+                    }
+                }
+                self.player = v
+                    .parked
+                    .take()
+                    .and_then(|uid| self.session.placed.iter().position(|p| p.uid == uid))
+                    .map(|i| self.session.placed.remove(i));
+                if let (Some(h), Some(p)) = (self.session.humans.as_mut(), self.player.as_mut()) {
+                    h.player_bus_swapped(borrowed_uid, p.uid, &mut p.vehicle);
+                }
+                self.session.on_foot = v.foot.take();
+                self.view = if self.session.on_foot.is_some() {
+                    "foot"
+                } else {
+                    "driver"
+                }
+                .into();
+            }
+        }
+        self.net.coop.camera = None;
+        self.input.keys.clear();
+        self.input.pad_repeat.clear();
+        self.net.coop.drive.request = None;
+    }
+    // Legacy input replay is intentionally never consumed as vehicle authority.
+    pub(crate) fn drive_receive(&mut self, _from: u32, _text: &str) -> bool {
+        false
+    }
+    fn drive_message(&mut self, from: u32, message: Message) {
+        let now = Instant::now();
+        match message {
+            Message::Work { token, actor, wire } => {
+                let valid = self.net.coop.drive.visitor.as_ref().is_some_and(|v| {
+                    v.owner == from && v.token == token && v.active && !v.returning
+                });
+                if !valid || wire.len() > 1024 {
+                    return;
+                }
+                if let Some(v) = self.net.coop.drive.visitor.as_mut() {
+                    v.actors.insert(actor);
+                }
+                match omsi_lan::coop::Message::parse(&wire) {
+                    Some(omsi_lan::coop::Message::Action(a))
+                        if a.target == omsi_lan::coop::Target::Player && a.kind <= 1 =>
+                    {
+                        self.coop_apply_delegated(actor, &a);
+                    }
+                    Some(omsi_lan::coop::Message::Keep(epoch)) => {
+                        self.coop_keep_delegated(actor, epoch);
+                    }
+                    _ => {}
+                }
+            }
+            Message::Request { nonce } => {
+                if !self.net.coop.drive.busy()
+                    && self.coop_peer_inside(from, omsi_lan::coop::Target::Player)
+                {
+                    self.net.coop.drive.requests.insert(from, (nonce, now));
+                    self.coop_notice("Um passageiro pediu a direção. Autorize no Cooperativo com o ônibus parado.","A passenger requested the wheel. Authorize in Cooperative while stopped.","Ein Fahrgast möchte fahren. Im Stand im Koop-Menü freigeben.");
+                }
+            }
+            Message::Offer {
+                nonce,
+                token,
+                uid,
+                bus,
+                hof,
+                paint,
+            } => {
+                let expected = self.net.coop.drive.request.is_some_and(|(p, n, t)| {
+                    p == from && n == nonce && t.elapsed() < Duration::from_secs(60)
+                });
+                if !expected || self.net.coop.drive.visitor.is_some() || uid == 0 || token == 0 {
+                    return;
+                }
+                let Some(BusId::Ai(id)) = self.foot_bus() else {
+                    return;
+                };
+                if crate::humans::remote_bus_player(id) != Some(from) {
+                    return;
+                }
+                // Resolve the actual locally mounted copy, including buses downloaded through mods.
+                let Some(remote) = self
+                    .net
+                    .remotes
+                    .remotes
+                    .get(&from)
+                    .filter(|r| !r.stand_in && !r.fallback)
+                else {
+                    return;
+                };
+                // Already mounted and validated for this peer; keep its
+                // absolute path instead of running the menu resolver again.
+                let local = remote.vehicle().ty.def.path.clone();
+                let (Some(world), Some(renderer)) = (self.world.clone(), self.renderer.as_ref())
+                else {
+                    return;
+                };
+                let args = Args {
+                    bus: Some(local.to_string_lossy().into_owned()),
+                    paint,
+                    hof,
