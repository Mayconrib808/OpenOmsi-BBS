diff --git a/crates/omsi-audio/src/greeting.rs b/crates/omsi-audio/src/greeting.rs
new file mode 100644
index 00000000..2104e007
--- /dev/null
+++ b/crates/omsi-audio/src/greeting.rs
@@ -0,0 +1,51 @@
+//! The existing model's horn, as two short greeting taps. A single reliable
+//! greeting event produces the same audible rhythm locally and on every peer.
+use crate::Clip;
+
+pub fn double_horn(source: &Clip) -> Clip {
+    let channels = usize::from(source.channels.max(1));
+    let tap_frames = (source.sample_rate as usize * 17 / 100).max(1);
+    let gap_frames = (source.sample_rate as usize * 14 / 100).max(1);
+    let fade_frames = (source.sample_rate as usize / 200).max(1);
+    let first = source.samples.chunks(channels)
+        .position(|frame| frame.iter().any(|s| i32::from(*s).abs() >= 128))
+        .unwrap_or(0).saturating_sub(fade_frames);
+    let available = source.frames().saturating_sub(first);
+    let mut tap = vec![0i16; tap_frames * channels];
+    if available != 0 {
+        for frame in 0..tap_frames {
+            let from = first + frame % available;
+            let gain = (frame.min(tap_frames - 1 - frame) as f32 / fade_frames as f32).min(1.0);
+            for channel in 0..channels {
+                tap[frame * channels + channel] = (source.samples[from * channels + channel] as f32 * gain) as i16;
+            }
+        }
+    }
+    let mut samples = Vec::with_capacity((2 * tap_frames + gap_frames) * channels);
+    samples.extend_from_slice(&tap);
+    samples.resize((tap_frames + gap_frames) * channels, 0);
+    samples.extend_from_slice(&tap);
+    Clip { sample_rate: source.sample_rate, channels: channels as u16, samples }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn two_distinct_model_horn_taps_with_a_silent_gap_on_both_channels() {
+        for rate in [22050, 44100, 48000] {
+            for channels in [1, 2] {
+                let source = Clip { sample_rate: rate, channels, samples: vec![12000; rate as usize * channels as usize] };
+                let clip = double_horn(&source);
+                let tap = rate as usize * 17 / 100 * channels as usize;
+                let gap = rate as usize * 14 / 100 * channels as usize;
+                assert_eq!(clip.samples.len(), 2 * tap + gap);
+                assert_eq!(&clip.samples[..tap], &clip.samples[tap + gap..]);
+                assert!(clip.samples[tap..tap + gap].iter().all(|s| *s == 0));
+                assert_eq!(*clip.samples[..tap].iter().max().unwrap(), 12000);
+                assert_eq!(clip.samples[0], 0);
+                assert_eq!(*clip.samples.last().unwrap(), 0);
+            }
+        }
+    }
+}
