+        sim.cars[0].vehicle.host.fired_triggers.push(HORN_EVENT.into());
+        sim.snapshot_sounds(&mut frame,DVec3::ZERO,250.0,0.0,None); assert_eq!(frame.honks.len(),1);
+        sim.snapshot_sounds(&mut frame,DVec3::ZERO,250.0,0.0,None); assert!(frame.honks.is_empty());
+    }
