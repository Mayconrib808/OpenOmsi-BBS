+        let (_f,mut sim)=scene(); let mut p=bus(BusId::Player(4),40.0,180.0,"2072"); let mut g=Greetings::default();
+        g.update(&mut sim,vec![p.clone()],0.1); p.high_beam=true;
+        for _ in 0..30 { g.update(&mut sim,vec![p.clone()],0.1); }
